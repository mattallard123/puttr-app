/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uilds/
# Xcode's derived data when xcodebuild is run from the project root (-derivedDataPath build): about 12 GB
/build/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/Shots/
*.csproj
*.sln
*.slnx
.vs/
.vscode/
.DS_Store

# Raw Soundly exports; Tools/import-sounds.py writes the trimmed copies into Assets/
/SoundDrop/*
!/SoundDrop/README.md

# Keys: local only (Tools/keys has the templates). GitHub flagged these on 62debba.
/Assets/PuttrApp/Scripts/Keys.cs
/Assets/PuttrApp/Scripts/Keys.cs.meta
/Assets/PuttrApp/Editor/Firebase/GoogleService-Info.plist
/Assets/PuttrApp/Editor/Firebase/GoogleService-Info.plist.meta
/Assets/Plugins/Android/PuttrApp.androidlib/res/values/firebase.xml
/Assets/Plugins/Android/PuttrApp.androidlib/res/values/firebase.xml.meta

# CC0 source art for Tracks (about 2 GB): Tools/tracks-art/fetch.py downloads it again; only the baked results ship
/Tools/tracks-art/source/

# Store screenshots and previews made by StoreAssets/screenshots/build.py and preview/build.py
/StoreAssets/out/

# Screenshots taken to check a change (a walk of the screens, a layout check): evidence for one session, not source.
# docs/event-venue-modes/check stays: build-plan.md shows those.
/docs/xp-levels/walk/
/docs/design-guidelines/check/
/docs/quests-reimagined/check/

# Unity's crash and editor leftovers, and macOS' own
*.stackdump
mono_crash.*
/MemoryCaptures/
/Recordings/
*.orig
.idea/

# The Soundly helper's own log
/Tools/soundly/*.log
