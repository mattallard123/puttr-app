/* The game replay (GameReplay.cs): the recording on black, the putt strip under it. Solid colours (App.uss top note). */
.rp-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); flex-direction: column; color: rgb(255, 255, 255); }
.rp-stage { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.rp-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.rp-center { align-items: center; justify-content: center; }
.rp-play { width: 64px; height: 64px; border-radius: 4px; background-color: rgb(21, 24, 27); border-width: 1px; border-color: rgb(38, 42, 46); align-items: center; justify-content: center; }
.rp-close { position: absolute; width: 44px; height: 44px; border-radius: 4px; background-color: rgb(21, 24, 27); align-items: center; justify-content: center; }
.rp-close:active { background-color: rgb(34, 38, 42); }
.rp-close-t { font-size: 28px; color: rgb(255, 255, 255); margin-top: -4px; -unity-text-align: middle-center; }

/* The putts: one card a putt, the one playing lit as a chip is (surface-2 and a white edge), not a green outline. */
.rp-strip { flex-grow: 0; flex-shrink: 0; padding-top: 12px; padding-bottom: 16px; background-color: rgb(10, 12, 13); border-top-width: 1px; border-color: rgb(38, 42, 46); }
.rp-strip .unity-scroll-view__content-container { flex-direction: row; padding-left: 12px; padding-right: 4px; }
.rp-chip { width: 136px; flex-shrink: 0; margin-right: 8px; padding: 8px; border-radius: 4px; background-color: rgb(21, 24, 27); border-width: 1px; border-color: rgb(38, 42, 46); }
.rp-chip-on { border-color: rgb(255, 255, 255); background-color: rgb(34, 38, 42); }
.rp-chip-top { flex-direction: row; align-items: center; }
.rp-num { width: 20px; height: 20px; border-radius: 4px; align-items: center; justify-content: center; }
.rp-num-t { font-size: 11px; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.rp-dist { font-size: 13px; color: rgb(255, 255, 255); margin-left: 8px; }
.rp-tee { font-size: 11px; color: rgb(139, 147, 153); margin-left: auto; }
.rp-chip-mid { flex-direction: row; align-items: center; margin-top: 8px; }
.rp-hole { width: 34px; height: 34px; margin: 0 8px 0 0; }
.rp-result { font-size: 13px; flex-shrink: 1; white-space: normal; }
.rp-pace { font-size: 13px; color: rgb(255, 255, 255); margin-top: 4px; }
.rp-entry { font-size: 11px; color: rgb(139, 147, 153); margin-top: 4px; white-space: normal; }
