/* 3D sessions (LabSession.cs, LabViewer.cs, LabUi.cs, LabExplore.cs, SessionOverview.cs, VideoDraw.cs), built to
   docs/design-guidelines.md ("Broadcast"): flat, solid colours from its table, type 28/20/15/13/11, spacing
   4/8/12/16/24/32, radius 4. The shared pieces (title, caps, num, body, card, window, strip, scope, btn, sec) are
   styled in App.uss; this sheet lays things out. Added to each screen's own root (LabUi.Style). */

/* ── Before filming (LabIntroScreen) and after (LabProcessingScreen) ── */
.lab-intro-title { margin-top: 8px; }
.lab-intro-body { margin-top: 8px; }
.lab-how { flex-direction: row; align-items: center; margin-top: 16px; min-height: 44px; }
.lab-how:active { background-color: rgb(34, 38, 42); }
.lab-how-icon { margin-right: 12px; flex-shrink: 0; }
.lab-how-words { flex-grow: 1; flex-basis: 0; }
.lab-how-end { margin-left: 8px; flex-shrink: 0; }
.lab-line { margin-top: 4px; }
.lab-dist { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.lab-dist > .scope { min-width: 60px; min-height: 44px; margin-bottom: 8px; align-items: center; justify-content: center; }
.lab-note { margin-top: 12px; }
.lab-done { align-items: center; padding-top: 16px; }
.lab-done-num { margin-top: 8px; -unity-text-align: middle-center; }
.lab-done-card { margin-top: 24px; align-items: center; }
.lab-done-status { -unity-text-align: middle-center; }

/* ── Filming (LabCaptureScreen). The live camera is a native view placed over .lab-picture; the guide on the picture
   is drawn by the plugin, not here. What is here shows only where the camera is not: the bottom bar, and the picture
   area's own message when there is no camera, no access, a failed start, or the face-on move after putt 3. ── */
.lab-cap { flex-grow: 1; background-color: rgb(0, 0, 0); }
.lab-picture { flex-grow: 1; flex-shrink: 1; align-items: center; justify-content: center; background-color: rgb(0, 0, 0); }
.lab-cover { align-items: center; padding: 24px; width: 100%; max-width: 380px; }
.lab-cover-title { margin-top: 16px; -unity-text-align: middle-center; }
.lab-cover-body { margin-top: 8px; -unity-text-align: middle-center; }
.lab-cover-actions { margin-top: 8px; align-self: stretch; }
.lab-capbar { flex-shrink: 0; padding: 12px 16px; background-color: rgb(10, 12, 13); border-top-width: 1px; border-color: rgb(38, 42, 46); }
.lab-caprow { flex-direction: row; align-items: center; }
.lab-capwords { flex-grow: 1; flex-basis: 0; }
.lab-count { margin-top: 4px; }
.lab-capbar .btn.lab-cap-btn { margin-top: 0; margin-left: 8px; padding-left: 20px; padding-right: 20px; flex-shrink: 0; }
.lab-progress { height: 4px; margin-top: 12px; overflow: hidden; background-color: rgb(34, 38, 42); }
.lab-progress-fill { height: 100%; width: 0px; background-color: rgb(45, 140, 60); }
.lab-last { margin-top: 12px; font-size: 13px; white-space: normal; }

/* ── Shared pieces ── */
.lab-gap { margin-top: 12px; }
.lab-empty-text { font-size: 13px; color: rgb(139, 147, 153); -unity-text-align: middle-center; padding: 16px 0; white-space: normal; }
.lab-round { align-items: center; justify-content: center; flex-shrink: 0; border-radius: 4px; }
.lab-round:active { opacity: 0.8; }
.lab-divider { height: 0; border-top-width: 1px; border-top-color: rgb(38, 42, 46); margin: 12px 0; }
/* A bordered block of rows split by dividers. */
.lab-block { background-color: rgb(21, 24, 27); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; overflow: hidden; }
.lab-item { padding: 12px 16px; border-top-width: 1px; border-top-color: rgb(38, 42, 46); }
.lab-item-first { border-top-width: 0; }
.lab-item-title { font-size: 15px; color: rgb(255, 255, 255); white-space: normal; flex-grow: 1; flex-basis: 0; margin: 0; padding: 0; }
/* A grid of reads: rows of cells split by dividers, a value over its caption. */
.lab-grid { background-color: rgb(21, 24, 27); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; overflow: hidden; }
.lab-grid-row { flex-direction: row; border-top-width: 1px; border-top-color: rgb(38, 42, 46); }
.lab-grid-row-first { border-top-width: 0; }
.lab-cell { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; padding: 12px 4px; min-height: 44px; border-left-width: 1px; border-left-color: rgb(38, 42, 46); }
.lab-cell-first { border-left-width: 0; }
.lab-cell-tap:active { background-color: rgb(34, 38, 42); }
.lab-cell-num { font-size: 20px; margin: 0; padding: 0; -unity-text-align: middle-center; }
.lab-cell-word { font-size: 13px; margin: 0; padding: 0; -unity-text-align: middle-center; white-space: normal; }
.caps.lab-cell-cap { margin-top: 4px; -unity-text-align: middle-center; white-space: normal; letter-spacing: 1px; }
.lab-block .lab-grid { border-width: 0; border-radius: 0; border-top-width: 1px; background-color: rgba(0, 0, 0, 0); }

/* ── The list (LabSessionsScreen) ── */
.btn.lab-record { margin-top: 12px; }
.lab-srow { flex-direction: row; align-items: center; padding: 12px; border-top-width: 1px; border-top-color: rgb(38, 42, 46); }
.lab-srow-first { border-top-width: 0; }
.lab-srow:active { background-color: rgb(34, 38, 42); }
.lab-thumb { width: 64px; height: 88px; border-radius: 4px; border-width: 1px; border-color: rgb(38, 42, 46); overflow: hidden; background-color: rgb(0, 0, 0); align-items: center; justify-content: center; margin-right: 12px; flex-shrink: 0; }
.lab-srow-words { flex-grow: 1; flex-basis: 0; }
.lab-row-top { flex-wrap: wrap; }
.lab-row-title { font-size: 15px; color: rgb(255, 255, 255); margin: 0 8px 0 0; padding: 0; }
.caps.lab-latest { margin-right: 8px; }
.lab-capture { flex-direction: row; align-items: center; }
.caps.lab-capture-text { margin-left: 4px; letter-spacing: 1px; }
.lab-row-ago { margin-top: 4px; }
.lab-bin { width: 44px; height: 44px; align-items: center; justify-content: center; margin-left: 8px; flex-shrink: 0; }
.lab-empty { align-items: center; padding: 32px 0; }
.lab-empty-title { margin-top: 12px; margin-bottom: 4px; -unity-text-align: middle-center; }

/* ── The session page (LabSessionScreen) ── */
.lab-who { flex-direction: row; align-items: center; padding: 8px 16px 0 16px; }
.avatar.lab-head-face { width: 44px; height: 44px; margin-right: 12px; }
.lab-who-words { flex-grow: 1; flex-basis: 0; }
.lab-banner { margin-top: 16px; }
.lab-banner-text { margin-top: 4px; }
.lab-banner-btns { flex-direction: row; margin-top: 12px; }
.lab-banner-btns > .btn { flex-grow: 1; flex-basis: 0; margin-top: 0; }
.lab-banner-btns > .btn.lab-banner-next { margin-left: 8px; }
.btn.lab-review { margin-top: 16px; flex-direction: row; }
.btn.lab-explore { margin-top: 8px; }
.lab-sev { margin-left: 8px; flex-shrink: 0; }
.lab-item-line { margin-top: 4px; }
/* Stacked above a line (not in a row), a title is as tall as its words: with a zero basis it collapsed and the line drew over it. */
.lab-item > .lab-item-title, .lab-drill-words > .lab-item-title { flex-grow: 0; flex-basis: auto; }
.lab-drill { flex-direction: row; align-items: center; min-height: 44px; }
.lab-drill:active { background-color: rgb(34, 38, 42); }
.lab-drill-icon { margin-right: 12px; flex-shrink: 0; }
.lab-drill-words { flex-grow: 1; flex-basis: 0; }
.body-2.lab-drill-desc { margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lab-drill-end { margin-left: 8px; flex-shrink: 0; }
.lab-processing { align-items: center; }
.lab-processing-text { margin-top: 12px; }
.lab-angle { flex-direction: row; align-items: center; margin-bottom: 8px; }
.lab-angle-next { margin-top: 16px; }
.lab-golfer-small { width: 24px; height: 30px; margin-right: 8px; flex-shrink: 0; }
.lab-help-value { margin-top: 8px; margin-bottom: 8px; }

/* ── The putt card (LabUi.PuttCard) and its ball-path card ── */
.lab-putt { flex-direction: row; background-color: rgb(21, 24, 27); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; overflow: hidden; }
.lab-putt:active { background-color: rgb(34, 38, 42); }
.lab-block .lab-putt { border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); }
.lab-block .lab-putt:active { background-color: rgb(34, 38, 42); }
.lab-pitem { border-top-width: 1px; border-top-color: rgb(38, 42, 46); }
.lab-pitem-first { border-top-width: 0; }
.lab-putt-grade { width: 64px; align-items: center; justify-content: center; padding: 12px 0; flex-shrink: 0; }
.lab-putt-letter { font-size: 28px; margin: 0; padding: 0; -unity-text-align: middle-center; }
.lab-putt-score { font-size: 11px; margin: 4px 0 0 0; padding: 0; -unity-text-align: middle-center; }
.lab-putt-main { flex-grow: 1; flex-basis: 0; padding: 12px 16px 12px 0; }
.lab-putt-ft { font-size: 15px; color: rgb(255, 255, 255); margin: 0 0 0 8px; padding: 0; }
.lab-putt-break { font-size: 13px; color: rgb(139, 147, 153); margin: 0 0 0 8px; padding: 0; }
.lab-pace { margin-top: 8px; }
.lab-pace-label { flex-grow: 1; flex-basis: 0; }
.lab-pace-value { font-size: 13px; margin: 0; padding: 0; }
.lab-pace-bar { height: 4px; background-color: rgb(34, 38, 42); overflow: hidden; margin-top: 4px; }
.lab-pace-fill { height: 4px; }
.lab-putt-result { margin-top: 8px; }
.lab-putt-made { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; flex-shrink: 0; }
.lab-putt-result > .unity-image { margin-right: 8px; }
.lab-putt-result-text { font-size: 13px; margin: 0; padding: 0; }
.lab-putt-compact .lab-putt-grade { width: 52px; padding: 8px 0; }
.lab-putt-compact .lab-putt-letter { font-size: 20px; }
.lab-putt-compact .lab-putt-main { padding: 8px 12px 8px 0; }
.lab-putt-compact .lab-putt-ft { font-size: 13px; }
.lab-putt-compact .lab-pace { margin-top: 4px; }
.lab-putt-compact .lab-putt-result { margin-top: 4px; }
.lab-putt-compact .lab-pace-value { font-size: 11px; }
.lab-putt-compact .lab-putt-result-text { font-size: 11px; }
.modal.lab-modal { max-width: 432px; padding: 16px; }
.lab-path-stage { height: 260px; }
.lab-path { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.lab-modal-head { margin-top: 16px; margin-bottom: 12px; }
.lab-modal-title { flex-grow: 1; flex-basis: 0; }
.lab-modal-sub { margin-top: 8px; -unity-text-align: middle-center; }
.btn.lab-modal-replay { margin-top: 12px; }

/* ── The 3D stroke model (StrokeModel): the picture in a window, its controls on the solid bar under it ── */
.lab-model { background-color: rgb(21, 24, 27); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; overflow: hidden; }
.lab-model-stage { height: 320px; overflow: hidden; background-color: rgb(21, 24, 27); }
.lab-model-picture { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.lab-model-bar { padding: 12px; border-top-width: 1px; border-top-color: rgb(38, 42, 46); }
.lab-model-controls { flex-direction: row; align-items: center; }
.lab-model-speed { width: 44px; height: 44px; border-radius: 4px; background-color: rgb(34, 38, 42); align-items: center; justify-content: center; flex-shrink: 0; }
.lab-model-speed:active { background-color: rgb(48, 53, 58); }
.lab-model-speed-text { font-size: 13px; margin: 0; padding: 0; }
.lab-model-phases { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.lab-model-chips { flex-direction: row; }
.lab-model-hint { margin-top: 4px; }
.lab-model-note { margin-top: 8px; }
.scope.lab-pill { margin: 0 8px 8px 0; flex-shrink: 0; }
.lab-pill-off { opacity: 0.3; }
.lab-scrub { flex-grow: 1; height: 44px; justify-content: center; margin: 0 12px; }
.lab-scrub-track { height: 4px; background-color: rgb(34, 38, 42); overflow: hidden; }
.lab-scrub-fill { height: 4px; background-color: rgb(45, 140, 60); width: 0; }
.lab-scrub-thumb { position: absolute; top: 12px; width: 8px; height: 20px; border-radius: 4px; margin-left: -4px; background-color: rgb(255, 255, 255); }
/* Full screen: the picture takes the screen above the same bar. */
.lab-model-screen { flex-grow: 1; background-color: rgb(0, 0, 0); }
.lab-model-full { flex-grow: 1; }
.lab-model-stage-full { flex-grow: 1; overflow: hidden; background-color: rgb(21, 24, 27); }
.lab-model-picture-full { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.lab-model-close { position: absolute; top: 56px; left: 16px; }
.lab-model-bottom { flex-shrink: 0; padding: 12px 16px 40px 16px; background-color: rgb(10, 12, 13); border-top-width: 1px; border-top-color: rgb(38, 42, 46); }

/* ── The manual replay (LabReplayScreen): the video full screen with its HUD over it ── */
.lab-replay { flex-grow: 1; background-color: rgb(0, 0, 0); overflow: hidden; }
.lab-replay-stage { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.lab-replay-note { position: absolute; left: 24px; right: 24px; top: 45%; font-size: 13px; color: rgb(139, 147, 153); -unity-text-align: middle-center; white-space: normal; }
.lab-replay-close { position: absolute; left: 16px; top: 52px; }
.lab-replay-hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.lab-replay-card { position: absolute; top: 52px; left: 68px; right: 68px; }
.lab-replay-card .lab-putt { background-color: rgb(10, 12, 13); }
.lab-replay-rail { position: absolute; right: 8px; top: 132px; bottom: 170px; justify-content: flex-end; align-items: flex-end; }
.lab-replay-rail-left { right: auto; left: 8px; align-items: flex-start; }
.lab-rail-pill { background-color: rgb(10, 12, 13); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 8px; min-width: 104px; margin-top: 8px; }
.lab-rail-value { font-size: 13px; margin: 0; padding: 0; }
.lab-rail-text { font-size: 11px; color: rgb(139, 147, 153); margin: 4px 0 0 0; padding: 0; }
.lab-replay-bottom { position: absolute; left: 12px; right: 12px; bottom: 30px; align-items: center; }
.lab-replay-phases { flex-direction: row; justify-content: center; margin-bottom: 12px; }
.lab-phase { background-color: rgb(10, 12, 13); border-radius: 4px; padding: 8px 6px; min-width: 72px; min-height: 44px; align-items: center; justify-content: center; margin: 0 2px; }
.lab-phase-label { font-size: 11px; letter-spacing: 0.5px; color: rgb(139, 147, 153); margin: 0; padding: 0; }
.lab-phase-value { font-size: 13px; color: rgb(255, 255, 255); margin: 4px 0 0 0; padding: 0; }
.lab-replay-panel { background-color: rgb(10, 12, 13); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 16px; margin-bottom: 12px; width: 100%; max-width: 440px; }
.lab-panel-head { margin-bottom: 12px; min-height: 44px; }
.lab-panel-title { font-size: 15px; color: rgb(255, 255, 255); flex-grow: 1; flex-basis: 0; margin: 0; padding: 0; }
.lab-panel-x { width: 44px; height: 44px; align-items: center; justify-content: center; flex-shrink: 0; }
.lab-ctrl { flex-direction: row; align-items: center; background-color: rgb(10, 12, 13); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 8px; width: 100%; max-width: 440px; }
.lab-ctrl-left > * { margin-right: 4px; }
.lab-ctrl-right { justify-content: flex-end; }
.lab-ctrl-mid > * { margin: 0 4px; }

/* ── The overlay switches (LabUi.OverlaySwitches) ── */
.lab-switch-head { margin-bottom: 8px; }
.lab-switch-title { flex-grow: 1; flex-basis: 0; }
.lab-switch-all { font-size: 13px; color: rgb(139, 147, 153); padding: 4px 0 4px 8px; margin: 0; }
.lab-switches { flex-direction: row; flex-wrap: wrap; }
.scope.lab-switch { margin: 0 8px 8px 0; }

/* ── The coach's review (CoachSessionScreen, VideoAnalysisScreen, ReviewParts) ── */
.lab-coach { flex-grow: 1; background-color: rgb(10, 12, 13); }
.lab-coach-body { flex-grow: 1; }
.lab-cols { flex-grow: 1; flex-direction: row; }
.lab-col { flex-grow: 1; flex-basis: 0; border-right-width: 1px; border-right-color: rgb(38, 42, 46); }
.lab-col-head { padding: 12px 16px; border-bottom-width: 1px; border-bottom-color: rgb(38, 42, 46); }
.caps.lab-col-title { flex-grow: 1; flex-basis: 0; color: rgb(255, 255, 255); }
.lab-col-fill { flex-grow: 1; }
.lab-col-foot { align-items: center; padding: 12px; border-top-width: 1px; border-top-color: rgb(38, 42, 46); background-color: rgb(10, 12, 13); }
.lab-panel { padding: 12px 12px 24px 12px; }
.caps.lab-panel-label { margin: 16px 0 8px 0; }
.lab-section-card { background-color: rgb(21, 24, 27); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 12px; margin-top: 12px; }
.lab-putt-chips { flex-direction: row; flex-wrap: wrap; margin-bottom: 4px; }
.lab-putt-chip { flex-grow: 1; flex-basis: 44px; min-height: 44px; align-items: center; justify-content: center; padding: 8px 0; border-radius: 4px; border-width: 1px; border-color: rgb(38, 42, 46); margin: 0 8px 8px 0; }
.lab-putt-chip-on { background-color: rgb(34, 38, 42); border-color: rgb(255, 255, 255); }
.lab-putt-chip-num { font-size: 13px; color: rgb(255, 255, 255); margin: 0; padding: 0; }
.lab-putt-chip-ft { font-size: 11px; color: rgb(139, 147, 153); margin: 4px 0 0 0; padding: 0; }
.lab-putt-chip-grade { font-size: 13px; margin: 4px 0 0 0; padding: 0; }
.btn.lab-save { margin-top: 12px; }
.lab-phase-row { margin-bottom: 12px; }
.lab-angle-name { font-size: 13px; color: rgb(139, 147, 153); margin: 0 12px 0 0; padding: 0; }
.lab-seg { background-color: rgb(34, 38, 42); border-radius: 4px; padding: 4px; flex-grow: 1; flex-basis: 0; }
.lab-seg-btn { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; min-height: 36px; border-radius: 4px; }
.lab-seg-btn:active { background-color: rgb(48, 53, 58); }
.lab-seg-text { font-size: 11px; color: rgb(255, 255, 255); margin: 0; padding: 0; }
.lab-transport { background-color: rgb(10, 12, 13); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 8px; }
.lab-transport > * { margin: 0 4px; }
.lab-transport-docked { border-width: 0; padding: 0; }
.lab-rail-dots { background-color: rgb(10, 12, 13); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 4px; margin: 8px 0; }
.lab-rail-num { width: 44px; height: 44px; border-radius: 4px; align-items: center; justify-content: center; background-color: rgb(34, 38, 42); border-width: 1px; border-color: rgb(38, 42, 46); margin: 0 2px; }
.lab-rail-num-on { background-color: rgb(48, 53, 58); border-color: rgb(255, 255, 255); }
.lab-rail-num-text { font-size: 13px; color: rgb(255, 255, 255); margin: 0; padding: 0; }
.lab-rail-dot { width: 6px; height: 6px; border-radius: 3px; margin-top: 4px; }
.lab-stage { flex-grow: 1; background-color: rgb(0, 0, 0); overflow: hidden; }
.lab-stage-frame { position: absolute; }
.lab-stage-note { position: absolute; left: 20px; right: 20px; top: 45%; font-size: 13px; color: rgb(139, 147, 153); -unity-text-align: middle-center; white-space: normal; }
.lab-stage-tools { position: absolute; top: 12px; left: 0; right: 0; flex-direction: row; justify-content: center; }
.lab-draw-bar { background-color: rgb(10, 12, 13); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 4px; align-self: center; }
.lab-va-area { flex-grow: 1; }
.lab-va-stage { position: absolute; left: 0; top: 0; right: 0; bottom: 62px; }
.lab-va-float { position: absolute; left: 0; right: 0; bottom: 76px; align-items: center; }
.lab-va-show { position: absolute; bottom: 76px; align-self: center; }
.lab-drawer { position: absolute; left: 0; right: 0; bottom: 0; height: 62px; background-color: rgb(10, 12, 13); border-top-left-radius: 4px; border-top-right-radius: 4px; border-width: 1px; border-color: rgb(38, 42, 46); overflow: hidden; }
.lab-drawer-handle { align-items: center; padding: 8px 0 4px 0; }
.lab-drawer-grip { width: 38px; height: 4px; border-radius: 2px; background-color: rgb(48, 53, 58); }
.lab-drawer-tabs { padding: 0 12px 8px 12px; }
.lab-drawer-tab { flex-grow: 1; flex-basis: 0; justify-content: center; align-items: center; padding: 8px 0; border-radius: 4px; border-width: 1px; border-color: rgb(38, 42, 46); margin: 0 4px; }
.lab-drawer-tab-on { background-color: rgb(255, 255, 255); border-color: rgb(255, 255, 255); }
.lab-drawer-tab-text { font-size: 13px; color: rgb(255, 255, 255); margin: 0 0 0 8px; padding: 0; }
.lab-drawer-tab-on .lab-drawer-tab-text { color: rgb(0, 0, 0); }
.lab-drawer-content { flex-grow: 1; }
