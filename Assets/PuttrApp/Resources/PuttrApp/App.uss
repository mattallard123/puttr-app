/* Puttr 2: the app's look, from puttr-app's AppStyles.COLORS and the Arcade palette.
   Every colour is solid. The project renders in linear colour for the arcade, and see-through
   whites blended that way come out far brighter than the same values do in the app, so the
   glass colours here are the app's rgba values worked out over the page background. */
.stage { flex-grow: 1; background-color: rgb(9, 11, 13); align-items: center; }
.app { flex-grow: 1; width: 100%; max-width: 480px; color: rgb(255, 255, 255); font-size: 14px; }
.screen-host { flex-grow: 1; }
.screen { flex-grow: 1; }
.pad { padding-left: 16px; padding-right: 16px; }

.top { flex-direction: row; align-items: center; justify-content: space-between; padding: 10px 16px 6px 16px; }
.logo { width: 92px; height: 24px; }
.pill { flex-direction: row; align-items: center; padding: 6px 10px; border-radius: 10px; border-width: 1px; border-color: rgb(38, 40, 42); background-color: rgb(8, 9, 9); font-size: 11px; }
.dot { width: 7px; height: 7px; border-radius: 4px; margin-right: 6px; background-color: rgb(255, 179, 0); }
.dot-on { background-color: rgb(122, 212, 70); }

.h1 { font-size: 24px; margin-top: 10px; margin-bottom: 4px; white-space: normal; }
.h2 { font-size: 20px; white-space: normal; }
.sub { font-size: 13px; color: rgb(184, 185, 185); white-space: normal; }
.muted { font-size: 11px; color: rgb(132, 133, 134); white-space: normal; }
.kick { font-size: 11px; letter-spacing: 1px; color: rgb(122, 212, 70); }
.center { -unity-text-align: middle-center; }
.error { font-size: 13px; color: rgb(255, 82, 82); white-space: normal; margin-top: 10px; }

.sec { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-top: 20px; margin-bottom: 10px; padding-left: 16px; padding-right: 16px; }
.sec-title { font-size: 15px; }
.sec-link { font-size: 12px; color: rgb(122, 212, 70); }

.glass { background-color: rgb(24, 26, 28); border-width: 1px; border-color: rgb(32, 34, 36); border-radius: 14px; padding: 14px; }
.hero { background-color: rgb(14, 30, 20); border-color: rgb(27, 76, 37); border-radius: 16px; margin-top: 12px; }
.fire { background-color: rgb(43, 24, 15); border-color: rgb(132, 66, 35); border-radius: 16px; margin-top: 12px; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; flex-shrink: 1; }

.btn { background-color: rgb(45, 140, 60); border-radius: 12px; padding: 14px; margin-top: 14px; align-items: center; justify-content: center; }
.btn:hover { background-color: rgb(52, 158, 68); }
.btn:active { background-color: rgb(36, 112, 48); }
.btn-ghost { background-color: rgb(24, 26, 28); border-width: 1px; border-color: rgb(38, 40, 42); }
.btn-ghost:hover { background-color: rgb(38, 40, 42); }
.btn-ghost:active { background-color: rgb(19, 21, 23); }
.btn-off { opacity: 0.45; }
.btn-text { font-size: 15px; color: rgb(255, 255, 255); }

.bar { height: 6px; border-radius: 3px; background-color: rgb(38, 40, 42); overflow: hidden; margin-top: 10px; }
.bar-fill { height: 6px; border-radius: 3px; background-color: rgb(45, 140, 60); }

.hscroll { flex-grow: 0; flex-shrink: 0; }
.tile { width: 150px; height: 150px; margin-left: 10px; justify-content: space-between; }
.tile-first { margin-left: 16px; }
.tile-title { font-size: 14px; margin-top: 8px; }
.tile .tile-desc { white-space: nowrap; text-overflow: ellipsis; }
.tile-desc { font-size: 11px; color: rgb(132, 133, 134); white-space: normal; max-height: 28px; overflow: hidden; }
.bubble { align-self: flex-start; flex-shrink: 0; width: 40px; height: 40px; border-radius: 12px; align-items: center; justify-content: center; }
.chips { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.chip { font-size: 10px; padding: 3px 8px; border-radius: 8px; background-color: rgb(44, 46, 48); margin-right: 5px; margin-top: 4px; }
.chip-green { background-color: rgb(27, 43, 23); color: rgb(122, 212, 70); }
.chip-amber { background-color: rgb(58, 45, 10); color: rgb(255, 179, 0); }

.feed-row { flex-direction: row; align-items: center; padding: 11px 16px; border-bottom-width: 1px; border-bottom-color: rgb(24, 26, 28); }
.avatar { width: 42px; height: 42px; border-radius: 21px; margin-right: 12px; background-color: rgb(38, 40, 42); align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
.avatar-big { width: 72px; height: 72px; border-radius: 36px; }
.avatar-letter { font-size: 16px; color: rgb(184, 185, 185); }
.feed-name { font-size: 14px; }
.feed-score { font-size: 16px; margin-left: 10px; }

.list-row { flex-direction: row; align-items: center; margin: 0 16px 10px 16px; }

.field { margin: 0 0 12px 0; }
.field .unity-base-text-field__input { background-color: rgb(24, 26, 28); border-width: 1px; border-color: rgb(38, 40, 42); border-radius: 12px; padding: 12px 14px; color: rgb(255, 255, 255); font-size: 16px; min-height: 50px; }
.field:focus .unity-base-text-field__input { border-color: rgb(122, 212, 70); }
.field .unity-base-text-field__input--placeholder { color: rgb(107, 108, 109); }

.code { font-size: 34px; letter-spacing: 6px; margin-top: 8px; margin-bottom: 4px; -unity-text-align: middle-center; }

.tabs { flex-direction: row; flex-shrink: 0; border-top-width: 1px; border-top-color: rgb(32, 34, 36); padding: 8px 6px 8px 6px; background-color: rgb(6, 7, 7); }
.tab { flex-grow: 1; flex-basis: 0; align-items: center; }
.tab-icon { width: 24px; height: 24px; margin-bottom: 3px; }
.tab-label { font-size: 10px; color: rgb(107, 108, 109); }
.tab-on .tab-label { color: rgb(122, 212, 70); }

.toast { position: absolute; left: 16px; right: 16px; bottom: 84px; background-color: rgb(20, 24, 26); border-width: 1px; border-color: rgb(44, 48, 50); border-radius: 12px; padding: 12px 14px; font-size: 13px; white-space: normal; -unity-text-align: middle-center; }
.perf { position: absolute; left: 8px; right: 8px; bottom: 76px; background-color: rgb(0, 0, 0); border-radius: 8px; padding: 6px 8px; font-size: 10px; color: rgb(122, 212, 70); white-space: normal; }
.hidden { display: none; }

/* Pushed screens */
.back { font-size: 14px; color: rgb(122, 212, 70); width: 76px; padding: 6px 0; }
.back-balance { width: 76px; }
.back-chevron { font-size: 34px; padding: 0 0 4px 2px; -unity-text-align: middle-left; height: 44px; }
.crest-image { -unity-background-scale-mode: scale-to-fit; }
.score-big { font-size: 76px; -unity-text-align: middle-center; margin-top: 8px; }
.board-row { flex-direction: row; align-items: center; padding: 9px 0; border-bottom-width: 1px; border-bottom-color: rgb(32, 34, 36); }
.board-place { width: 26px; font-size: 13px; color: rgb(132, 133, 134); }

/* Free putt */
.choice { flex-direction: row; margin-top: 10px; background-color: rgb(14, 16, 18); border-radius: 12px; padding: 4px; }
.choice-item { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; padding: 11px 4px; border-radius: 9px; }
.choice-on { background-color: rgb(45, 140, 60); }
.choice-text { font-size: 13px; -unity-text-align: middle-center; white-space: normal; }
.stepper { flex-direction: row; align-items: center; justify-content: space-between; background-color: rgb(14, 16, 18); border-radius: 12px; padding: 4px; }
.stepper-button { width: 48px; height: 44px; border-radius: 9px; background-color: rgb(38, 40, 42); align-items: center; justify-content: center; }
.stepper-button:active { background-color: rgb(52, 56, 58); }
.stepper-sign { font-size: 22px; }
.stepper-value { font-size: 17px; -unity-text-align: middle-center; flex-grow: 1; }
.score-mid { font-size: 54px; -unity-text-align: middle-center; margin-top: 2px; }
.stat { align-items: center; flex-basis: 0; }
.stat-value { font-size: 24px; -unity-text-align: middle-center; }
.putt-view { height: 190px; margin-top: 12px; border-radius: 12px; overflow: hidden; background-color: rgb(14, 16, 18); }

/* A game sharing the screen with one of the app's panels */
.stage-clear { background-color: rgba(0, 0, 0, 0); }
.sheet { position: absolute; background-color: rgb(9, 11, 13); border-top-width: 1px; border-top-color: rgb(38, 40, 42); padding-left: 12px; padding-right: 12px; color: rgb(255, 255, 255); font-size: 14px; }
.sheet-wide { border-top-width: 0; border-left-width: 1px; border-left-color: rgb(38, 40, 42); }
.sheet-card { background-color: rgb(24, 26, 28); border-width: 1px; border-color: rgb(32, 34, 36); border-radius: 14px; padding: 12px; margin-top: 10px; }
.sheet-note { background-color: rgb(27, 76, 37); border-radius: 12px; padding: 10px 12px; margin-top: 10px; font-size: 14px; -unity-text-align: middle-center; white-space: normal; }
.btn-small { background-color: rgb(38, 40, 42); border-radius: 10px; padding: 10px 18px; align-items: center; justify-content: center; flex-shrink: 0; }
.btn-small:active { background-color: rgb(52, 56, 58); }

/* The tee button and its picker */
.icon-btn { width: 44px; height: 44px; border-radius: 12px; background-color: rgb(27, 43, 23); border-width: 1px; border-color: rgb(27, 76, 37); align-items: center; justify-content: center; margin-right: 8px; flex-shrink: 0; }
.icon-btn:active { background-color: rgb(27, 76, 37); }
.modal-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6); align-items: center; justify-content: center; padding: 16px; color: rgb(255, 255, 255); font-size: 14px; }
.modal { width: 100%; max-width: 380px; background-color: rgb(18, 20, 22); border-width: 1px; border-color: rgb(44, 48, 50); border-radius: 18px; padding: 18px; }
.tee-grid { flex-direction: row; flex-wrap: wrap; margin-top: 6px; margin-left: -4px; margin-right: -4px; }
.tee-cell { width: 33.33%; padding: 4px; align-items: center; }
.tee-cell > .tee-number { }
.tee-number { font-size: 22px; -unity-text-align: middle-center; }
.tee-cell { height: 62px; justify-content: center; border-radius: 12px; }
.tee-on { background-color: rgb(45, 140, 60); }

/* Profile */
.avatar-member { border-width: 2px; border-color: rgb(122, 212, 70); }
.profile-row { flex-direction: row; align-items: center; margin-top: 14px; padding-top: 14px; border-top-width: 1px; border-top-color: rgb(32, 34, 36); }
.profile-counts { margin-top: 14px; padding-top: 14px; border-top-width: 1px; border-top-color: rgb(32, 34, 36); }
.medal-item { width: 96px; margin-left: 10px; align-items: center; }
.medal { width: 64px; height: 64px; border-radius: 32px; align-items: center; justify-content: center; }
.medal-title { font-size: 12px; margin-top: 8px; -unity-text-align: upper-center; white-space: normal; }
.medal-desc { font-size: 11px; color: rgb(132, 133, 134); margin-top: 2px; -unity-text-align: upper-center; white-space: normal; }
.challenge { width: 250px; margin-left: 10px; }
.challenge .chip { align-self: flex-start; }
.activity-words { margin-left: 14px; justify-content: center; }
.heat { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.heat-cell { width: 14.2857%; padding: 3px; }
.heat-dot { height: 22px; border-radius: 6px; }
.months { flex-direction: row; align-items: flex-end; height: 150px; }
.month { flex-grow: 1; flex-basis: 0; align-items: center; height: 100%; }
.month-value { font-size: 11px; color: rgb(184, 185, 185); -unity-text-align: middle-center; height: 16px; }
.month-track { flex-grow: 1; width: 60%; justify-content: flex-end; margin-top: 4px; margin-bottom: 6px; }
.month-bar { background-color: rgb(45, 140, 60); border-radius: 5px; width: 100%; }
.legend { margin-bottom: 6px; flex-wrap: wrap; }
.legend-item { margin-right: 14px; margin-bottom: 4px; }
.legend-dot { width: 9px; height: 9px; border-radius: 5px; margin-right: 6px; }
.line-fill { height: 6px; border-radius: 3px; }
.ring-item { align-items: center; flex-basis: 0; }
.ring { width: 80px; height: 80px; align-items: center; justify-content: center; margin-bottom: 8px; }
.ring-value { font-size: 17px; -unity-text-align: middle-center; }

/* Home: this week */
.week { flex-direction: row; margin-top: 12px; }
.week-day { flex-grow: 1; flex-basis: 0; align-items: center; }
.week-dot { width: 30px; height: 30px; border-radius: 15px; background-color: rgb(24, 40, 28); align-items: center; justify-content: center; }
.week-on { background-color: rgb(45, 140, 60); }
.week-today { border-width: 2px; border-color: rgb(122, 212, 70); }
.week-letter { font-size: 11px; color: rgb(184, 185, 185); -unity-text-align: middle-center; }
.week-on .week-letter { color: rgb(255, 255, 255); }

/* Rounds, tournaments */
.hero-card { background-color: rgb(14, 30, 20); border-color: rgb(27, 76, 37); }
.sheet-warn { background-color: rgb(58, 45, 10); color: rgb(255, 179, 0); }
.poster { border-radius: 14px; overflow: hidden; background-color: rgb(24, 26, 28); justify-content: flex-end; flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; }
.poster-hero { height: 200px; margin-bottom: 4px; }
.poster-panel { background-color: rgba(9, 11, 13, 0.86); padding: 10px 12px; }
.poster-line { margin-top: 4px; }
.poster-chip { position: absolute; left: 10px; top: 10px; }
.prize-words { margin-left: 12px; }
.champion { border-color: rgb(120, 100, 20); }
.champion-row { margin-top: 10px; }
.round-tiles { margin-left: -4px; margin-right: -4px; }
.round-tile { flex-grow: 1; flex-basis: 0; margin: 0 4px; padding: 12px 6px; align-items: center; }
.round-now { border-color: rgb(122, 212, 70); }
.round-chip { margin-top: 8px; margin-right: 0; }
.board-me { background-color: rgb(14, 30, 20); border-radius: 10px; }

/* League Night */
.crest { align-items: center; justify-content: center; flex-shrink: 0; }
.crest-letter { color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.crest-words { margin-left: 12px; }
.scope { padding: 8px 14px; border-radius: 18px; background-color: rgb(24, 26, 28); margin-right: 8px; }
.scope-on { background-color: rgb(45, 140, 60); }
.scope-text { font-size: 12px; }
.team-grid { flex-direction: row; flex-wrap: wrap; margin: 12px -5px 0 -5px; }
.team-slot { width: 50%; padding: 5px; }
.team-cell { align-items: center; padding: 14px 8px; border-width: 2px; }
.team-on { background-color: rgb(30, 32, 34); }

/* Profile pages */
.social-tab { flex-grow: 1; flex-basis: 0; padding: 12px 0; border-radius: 12px; background-color: rgb(16, 18, 20); align-items: center; margin-right: 6px; }
.social-on { background-color: rgb(38, 40, 42); }
.social-count { font-size: 18px; -unity-text-align: middle-center; }
.social-find { width: 64px; border-radius: 12px; background-color: rgb(24, 26, 28); align-items: center; justify-content: center; }
.member-row { flex-direction: row; align-items: center; padding: 8px 2px; }
.member-row .avatar { margin-right: 12px; }
.follow { background-color: rgb(45, 140, 60); border-radius: 8px; padding: 7px 14px; }
.follow-on { background-color: rgb(32, 34, 36); }
.follow-text { font-size: 12px; }
.follow-on .follow-text { color: rgb(132, 133, 134); }
.count-tile { background-color: rgb(24, 26, 28); border-radius: 12px; padding: 10px 14px; align-items: center; min-width: 86px; }
.chip-join { align-self: flex-start; background-color: rgb(45, 140, 60); border-radius: 6px; padding: 5px 14px; font-size: 12px; }
.challenge-hero { align-items: center; }
.medal-big { width: 90px; height: 90px; border-radius: 45px; margin-bottom: 10px; }
.challenge-unit { margin-left: 8px; align-self: flex-end; margin-bottom: 10px; }
.challenge-earned { align-self: flex-start; margin-bottom: 10px; }
.challenge-line { margin-top: 8px; }
.tier-dot { width: 26px; height: 26px; border-radius: 13px; margin-right: 12px; }

/* The month calendar and the line chart */
.calendar { background-color: rgb(16, 18, 20); border-radius: 12px; padding: 6px 4px 10px 4px; }
.calendar-head { padding: 4px 6px 8px 6px; }
.calendar-arrow { font-size: 22px; color: rgb(107, 108, 109); width: 36px; -unity-text-align: middle-center; }
.calendar-month { font-size: 14px; -unity-text-align: middle-center; }
.calendar-cell { width: 14.2857%; height: 40px; align-items: center; justify-content: center; }
.calendar-name { font-size: 11px; color: rgb(107, 108, 109); -unity-text-align: middle-center; }
.calendar-day { width: 36px; height: 36px; border-radius: 18px; align-items: center; justify-content: center; }
.calendar-on { background-color: rgb(45, 140, 60); }
.calendar-today { border-width: 1.5px; border-color: rgb(45, 140, 60); }
.calendar-number { font-size: 14px; color: rgb(184, 185, 185); -unity-text-align: middle-center; }
.calendar-on .calendar-number { color: rgb(255, 255, 255); }
.line-chart { height: 220px; }
.chart-label { position: absolute; font-size: 10px; color: rgb(107, 108, 109); }

/* Make % by distance, as the app draws it */
.distance-row { flex-direction: row; align-items: center; padding: 10px 0; border-top-width: 1px; border-top-color: rgb(32, 34, 36); }
.distance-feet { width: 44px; align-items: center; }
.distance-number { font-size: 22px; -unity-text-align: middle-center; }
.distance-bars { margin-left: 12px; }
.line { align-items: center; margin-top: 2px; margin-bottom: 2px; }
.line-track { height: 6px; border-radius: 3px; background-color: rgb(32, 34, 36); overflow: hidden; }
.line-value { font-size: 11px; }

/* Play, as the sports UI draws it */
.display { font-size: 30px; -unity-font-style: bold-and-italic; letter-spacing: 1px; margin-top: 10px; }
.tile-name { font-size: 17px; -unity-font-style: bold-and-italic; letter-spacing: 0.5px; }
.tile-best { font-size: 12px; margin-left: 10px; -unity-text-align: middle-right; width: 92px; white-space: normal; }

/* Improve and Full analysis */
.next-score { width: 90px; align-items: center; justify-content: center; }
.next-words { margin-left: 12px; }
.spots { margin-left: -5px; margin-right: -5px; }
.spot-card { margin: 0 5px; }
.spot-row { align-items: center; height: 44px; }
.spot-feet { width: 52px; flex-shrink: 0; }
.spot-cell { align-items: center; }
.spot-dot { width: 38px; height: 38px; border-radius: 19px; background-color: rgb(32, 34, 36); align-items: center; justify-content: center; }
.spot-value { font-size: 12px; -unity-text-align: middle-center; }
.split { height: 8px; border-radius: 4px; overflow: hidden; margin-top: 8px; }
.split-a { height: 8px; }
.split-b { height: 8px; }
.entry-arc { height: 190px; }
.entry-value { color: rgb(255, 255, 255); font-size: 12px; }

/* The shared game frame */
.frame { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(255, 255, 255); font-size: 14px; }
.frame-over { position: absolute; align-items: center; }
.frame-bug { align-items: center; }
.bug { flex-direction: row; align-items: stretch; background-color: rgb(9, 11, 13); border-width: 1px; border-color: rgb(44, 48, 50); border-radius: 12px; overflow: hidden; }
.bug-player { padding: 6px 12px 6px 6px; }
.bug-avatar { width: 30px; height: 30px; border-radius: 15px; margin-right: 8px; }
.bug-name { font-size: 14px; margin-right: 12px; }
.bug-score { font-size: 20px; -unity-font-style: bold-and-italic; }
.bug-progress { background-color: rgb(45, 140, 60); padding: 0 12px; justify-content: center; }
.bug-round { font-size: 12px; letter-spacing: 1px; }
.tee-sign { position: absolute; left: 12px; top: 54px; background-color: rgb(9, 11, 13); border-width: 1px; border-color: rgb(44, 48, 50); border-radius: 14px; padding: 10px 16px; align-items: center; }
.tee-feet { font-size: 30px; -unity-font-style: bold-and-italic; -unity-text-align: middle-center; }
.read-head { font-size: 26px; -unity-font-style: bold-and-italic; letter-spacing: 1px; }
.read-points { align-items: center; margin-left: 10px; }
.read-number { font-size: 34px; -unity-font-style: bold-and-italic; -unity-text-align: middle-center; }
.read-line { align-items: center; padding: 9px 0; border-top-width: 1px; border-top-color: rgb(32, 34, 36); }
.read-label { font-size: 11px; letter-spacing: 1px; color: rgb(132, 133, 134); width: 64px; }
.read-text { font-size: 15px; }
.read-grade { font-size: 13px; margin-left: 8px; }
.player-card { align-items: center; padding: 16px; }
.card-rating { align-items: center; width: 84px; }

/* Settings and notifications */
.set-card { padding: 0 14px; }
.set-row { flex-direction: row; align-items: center; padding: 14px 0; border-bottom-width: 1px; border-bottom-color: rgb(32, 34, 36); min-height: 52px; }
.set-row:active { background-color: rgb(30, 32, 34); }
.set-words { margin-left: 12px; margin-right: 8px; }
.set-right { flex-direction: row; align-items: center; }
.set-links { justify-content: center; margin-top: 22px; }
.switch { width: 46px; height: 28px; border-radius: 14px; background-color: rgb(52, 54, 56); padding: 3px; flex-shrink: 0; }
.switch-knob { width: 22px; height: 22px; border-radius: 11px; background-color: rgb(255, 255, 255); }
.switch-on { background-color: rgb(45, 140, 60); align-items: flex-end; }
.center-box { align-items: center; }
.head-icon { width: 44px; height: 44px; align-items: center; justify-content: center; flex-shrink: 0; }
.bell-count { position: absolute; top: 4px; right: 2px; min-width: 18px; height: 18px; border-radius: 9px; background-color: rgb(45, 140, 60); font-size: 10px; color: rgb(255, 255, 255); -unity-text-align: middle-center; padding: 0 4px; }
.note-row { flex-direction: row; align-items: flex-start; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: rgb(32, 34, 36); }
.note-face { width: 44px; height: 44px; border-radius: 22px; background-color: rgb(44, 46, 48); align-items: center; justify-content: center; flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; }
.note-icon { background-color: rgb(27, 43, 23); }
.note-initial { font-size: 18px; color: rgb(255, 255, 255); }
.note-badge { position: absolute; right: -2px; bottom: -2px; width: 18px; height: 18px; border-radius: 9px; background-color: rgb(45, 140, 60); align-items: center; justify-content: center; border-width: 2px; border-color: rgb(24, 26, 28); }
.note-dot { width: 9px; height: 9px; border-radius: 5px; background-color: rgb(122, 212, 70); margin-top: 6px; flex-shrink: 0; }
.profile-top { flex-direction: row; align-items: center; }
.level-root { flex-grow: 1; }
.level-stage { min-height: 260px; align-items: center; justify-content: flex-end; }
.level-big { font-size: 40px; color: rgb(255, 255, 255); }
.level-axis { font-size: 22px; color: rgb(255, 255, 255); margin-top: 4px; }
.level-pill { position: absolute; top: 12px; align-self: center; font-size: 13px; letter-spacing: 2px; color: rgb(255, 255, 255); background-color: rgb(45, 140, 60); border-radius: 14px; padding: 6px 16px; }

/* Tablets and phones on their side (App.Layout sets .tablet, and .wide when there is room for two columns).
   The app fills the screen; the page is a centred column up to 1000 wide (the RN app's tablet width);
   tab roots put their cards in two columns. */
.app.tablet { max-width: none; }
.wide .page-viewport { align-items: center; }
.wide .page-column { width: 100%; max-width: 1000px; }
.wide .tabs { padding-left: 15%; padding-right: 15%; }
.cols { }
.wide .cols { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.wide .cols > .col { width: 50%; }
.wide .cols > .col-full { width: 100%; }
.wide .toast { max-width: 520px; align-self: center; }

/* Quests */
.quest-card { width: 190px; margin-right: 10px; padding: 0 0 12px 0; overflow: hidden; }
.quest-card > .chips, .quest-card > .quest-desc, .quest-card > .row { margin-left: 12px; margin-right: 12px; }
.quest-head { height: 84px; align-items: center; justify-content: center; padding: 8px; margin-bottom: 6px; }
.quest-title { font-size: 15px; color: rgb(255, 255, 255); -unity-text-align: middle-center; white-space: normal; }
.quest-desc { max-height: 36px; overflow: hidden; margin-top: 6px; }
.quest-lock { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.72); align-items: center; justify-content: center; }
.star-row { align-items: center; }
.star { border-radius: 50%; margin-right: 4px; }
.level-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.level-tile { width: 104px; height: 122px; margin: 5px; align-items: center; justify-content: center; padding: 8px; }
.level-locked { opacity: 0.45; }
.level-num { font-size: 34px; color: rgb(255, 255, 255); margin-bottom: 6px; }

/* Train & learn */
.lib-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.lib-tile { width: 48.5%; flex-direction: row; align-items: center; margin-bottom: 10px; padding: 12px; }
.wide .lib-tile { width: 32%; }
.lib-title { margin-left: 10px; font-size: 13px; white-space: normal; flex-shrink: 1; color: rgb(255, 255, 255); }
.lesson-card { width: 180px; height: 220px; margin-right: 10px; border-radius: 14px; overflow: hidden; background-color: rgb(24, 26, 28); justify-content: flex-end; -unity-background-scale-mode: scale-and-crop; }
.lesson-words { background-color: rgb(12, 14, 16); padding: 10px; }
.lesson-desc { max-height: 30px; overflow: hidden; }
.lesson-chip { position: absolute; left: 8px; top: 8px; }
.lesson-hero { height: 210px; border-radius: 14px; overflow: hidden; background-color: rgb(24, 26, 28); align-items: center; justify-content: center; -unity-background-scale-mode: scale-and-crop; }
.wide .lesson-hero { height: 380px; }
.lesson-play { width: 64px; height: 64px; border-radius: 32px; background-color: rgb(45, 140, 60); align-items: center; justify-content: center; }
.lesson-play-mark { font-size: 24px; color: rgb(255, 255, 255); }
.rate-star { width: 46px; height: 46px; border-radius: 23px; background-color: rgb(38, 40, 42); align-items: center; justify-content: center; margin-right: 8px; }
.rate-on { background-color: rgb(255, 179, 0); }

/* Versus and Live */
.rival-card { width: 150px; margin-right: 10px; align-items: center; padding: 12px; }
.versus-card { width: 230px; margin-right: 10px; }
.live-card { border-color: rgb(140, 40, 40); }
.chip-red { background-color: rgb(60, 20, 20); color: rgb(255, 82, 82); }
.friend { width: 84px; align-items: center; margin-right: 8px; padding: 6px; border-radius: 12px; border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.friend-on { border-color: rgb(122, 212, 70); }
.match-card { margin: 0 5px 10px 5px; }
.live-sheet { padding: 12px; }

/* Profiles */
.player-switch { flex-direction: row; align-items: center; padding: 4px 10px 4px 4px; border-radius: 20px; background-color: rgb(24, 26, 28); border-width: 1px; border-color: rgb(38, 40, 42); }
.player-switch > Label { margin-left: 6px; }
.player-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 10px; }
.player-tile { width: 80px; align-items: center; margin: 6px; padding: 6px; border-radius: 12px; }
/* Who's putting: avatar, name and OWNER/KID mark all on the tile's middle (the avatar's row margin and the mark's
   letter spacing pulled them left). */
.player-tile .avatar { margin-left: 0; margin-right: 0; }
.player-tile > Label { align-self: stretch; -unity-text-align: middle-center; white-space: normal; margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; }
.player-tile > .kick { letter-spacing: 0; }
.player-me { background-color: rgb(27, 43, 23); }
.player-add { width: 58px; height: 58px; border-radius: 29px; border-width: 2px; border-color: rgb(80, 82, 84); align-items: center; justify-content: center; }
.pin-pad { flex-direction: row; flex-wrap: wrap; justify-content: center; margin: 10px 0; }
.pin-key { width: 30%; height: 54px; margin: 1.5%; border-radius: 12px; background-color: rgb(38, 40, 42); align-items: center; justify-content: center; }
.pin-blank { background-color: rgba(0, 0, 0, 0); }
.crew-preview { width: 110px; height: 110px; border-radius: 55px; background-color: rgb(38, 40, 42); -unity-background-scale-mode: scale-to-fit; }
.crew-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.crew-pick { width: 23%; height: 72px; margin-bottom: 8px; border-radius: 36px; border-width: 3px; border-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; }
.crew-on { border-color: rgb(122, 212, 70); }
.swatch { width: 32px; height: 32px; border-radius: 16px; margin-right: 10px; border-width: 3px; border-color: rgba(0, 0, 0, 0); }
.swatch-on { border-color: rgb(255, 255, 255); }

/* Pages */
.medal-grid { flex-direction: row; flex-wrap: wrap; }
.medal-cell { width: 25%; align-items: center; margin-bottom: 10px; }
.edit-group { margin-top: 16px; }

/* Admin */
.adm-card { padding: 12px 14px; }
.adm-key { width: 40%; white-space: normal; }
.adm-value { flex-grow: 1; flex-shrink: 1; -unity-text-align: upper-right; white-space: normal; font-size: 13px; }
.adm-tiles { flex-direction: row; flex-wrap: wrap; }
.adm-tile { width: 33.3%; padding: 6px 4px 10px 0; }
.adm-thumb { width: 54px; height: 54px; border-radius: 10px; background-color: rgb(38, 40, 42); flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; }
.adm-cert { background-color: rgb(14, 22, 38); border-color: rgb(52, 80, 140); }
.adm-device { width: 170px; margin-right: 10px; }
.adm-labtile { width: 84px; height: 84px; margin-right: 8px; align-items: center; justify-content: center; padding: 6px; }
.adm-bars { flex-direction: row; align-items: flex-end; height: 110px; margin-top: 8px; }
.adm-barcol { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: flex-end; }
.adm-barcol > Label { font-size: 9px; white-space: nowrap; }
.adm-bar { width: 60%; border-radius: 3px; margin: 2px 0; }
.adm-putt { margin: 0 5px 10px 5px; }
.adm-path { height: 200px; border-radius: 10px; overflow: hidden; margin-bottom: 8px; }
.adm-proof { width: 44px; height: 44px; border-radius: 8px; background-color: rgb(38, 40, 42); -unity-background-scale-mode: scale-and-crop; }
.adm-criterion { padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgb(32, 34, 36); }
.adm-reason { margin-bottom: 8px; }
.adm-log { flex-direction: row; align-items: flex-start; padding: 8px 0; }
.adm-dot { width: 10px; height: 10px; border-radius: 5px; margin-top: 5px; flex-shrink: 0; }
.adm-member { padding: 10px 12px; align-items: center; flex-wrap: wrap; }
.btn-red { background-color: rgb(140, 34, 34); }

/* Profile photo */
.photo-pick { width: 96px; height: 96px; align-items: center; justify-content: center; }
.photo-badge { position: absolute; right: 2px; bottom: 2px; width: 30px; height: 30px; border-radius: 15px; background-color: rgb(45, 140, 60); align-items: center; justify-content: center; border-width: 2px; border-color: rgb(9, 11, 13); }
.photo-busy { opacity: 0.4; }

/* Club plans */
.plan { flex-direction: row; align-items: center; padding: 14px; border-radius: 14px; border-width: 1px; border-color: rgb(44, 46, 48); margin-top: 10px; }
.plan-on { background-color: rgb(18, 36, 22); border-color: rgb(45, 140, 60); }
.plan-dot { width: 18px; height: 18px; border-radius: 9px; border-width: 2px; border-color: rgb(107, 108, 109); }
.plan-dot-on { border-color: rgb(45, 140, 60); background-color: rgb(45, 140, 60); }

/* Chats */
.chat-screen { flex-grow: 1; }
.chat-screen > .screen { flex-grow: 1; }
.chat-top { padding: 4px 16px 8px 16px; border-bottom-width: 1px; border-bottom-color: rgb(32, 34, 36); }
.chat-pill { flex-direction: row; align-items: center; padding: 7px 12px; border-radius: 999px; background-color: rgb(32, 34, 36); }
.chat-intro { margin: 14px 0; }
.chat-row { flex-direction: row; align-items: flex-end; padding: 4px 16px; }
.chat-row-mine { justify-content: flex-end; }
.chat-bubble { max-width: 80%; padding: 10px 14px; border-radius: 16px; border-bottom-left-radius: 4px; background-color: rgb(30, 32, 34); margin-left: 8px; }
.chat-mine { background-color: rgb(45, 140, 60); border-bottom-left-radius: 16px; border-bottom-right-radius: 4px; margin-left: 0; }
.chat-text { font-size: 14px; color: rgb(255, 255, 255); white-space: normal; }
.chat-typing { color: rgb(122, 212, 70); font-size: 18px; margin-left: 46px; }
.chat-recs { padding: 6px 16px 10px 52px; }
.chat-composer { flex-direction: row; align-items: flex-end; padding: 8px 12px; border-top-width: 1px; border-top-color: rgb(32, 34, 36); background-color: rgb(6, 7, 7); flex-shrink: 0; }
.chat-input { flex-grow: 1; margin: 0 8px 0 0; }
.chat-input .unity-base-text-field__input { background-color: rgb(24, 26, 28); border-radius: 20px; border-width: 0; padding: 10px 14px; color: rgb(255, 255, 255); font-size: 15px; min-height: 40px; }
.chat-send { width: 40px; height: 40px; border-radius: 20px; background-color: rgb(45, 140, 60); align-items: center; justify-content: center; flex-shrink: 0; }
.chat-locked { padding: 14px 16px; background-color: rgb(40, 32, 12); border-top-width: 1px; border-top-color: rgb(90, 70, 20); flex-shrink: 0; }

/* Sign in and onboarding */
.intro { padding-top: 70px; }
.intro-logo { width: 220px; height: 70px; margin-bottom: 26px; }
.intro-hero { font-size: 34px; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.intro-chips { margin: 22px 0 30px 0; justify-content: center; }
.intro-chip { flex-direction: row; align-items: center; padding: 6px 10px; margin: 0 4px; border-radius: 14px; background-color: rgb(24, 26, 28); }
.intro-chip > Label { margin-left: 6px; }
.intro-btn { width: 100%; max-width: 420px; margin-top: 10px; }
.btn-white { background-color: rgb(255, 255, 255); }
.btn-white .btn-text { color: rgb(9, 11, 13); }
.email-sheet { max-width: 480px; }
.onboard-top { align-items: center; height: 44px; }
.onboard { padding-top: 30px; }
.onboard-choice { height: 120px; align-items: center; justify-content: center; }
.choice-on { border-color: rgb(45, 140, 60); background-color: rgb(18, 36, 22); }
.hcp-grid { flex-direction: row; flex-wrap: wrap; }
.hcp { margin-bottom: 8px; min-width: 56px; align-items: center; }

/* Creator */
.creator-card { margin: 0 5px 10px 5px; }
.diff-dot { width: 8px; height: 8px; border-radius: 4px; margin: 6px 3px 0 0; }
.green-grid { background-color: rgb(20, 48, 26); border-radius: 12px; padding: 8px; }
.green-row { align-items: center; justify-content: space-between; height: 30px; }
.green-ft { width: 46px; }
.green-tee { width: 22px; height: 22px; border-radius: 11px; background-color: rgb(40, 80, 48); }
.green-on { background-color: rgb(255, 255, 255); }

/* Coaching, lessons, Junior (Coaching.cs, Lessons.cs, CoachDesk.cs, Junior.cs) */
.form-label { font-size: 11px; color: rgb(140, 142, 144); letter-spacing: 1px; margin-top: 14px; margin-bottom: 6px; }
.pills { flex-direction: row; flex-wrap: wrap; }
.pills > .scope { margin-bottom: 8px; }
.area .unity-base-text-field__input { min-height: 120px; white-space: normal; -unity-text-align: upper-left; }
.check-row { flex-direction: row; align-items: flex-start; padding: 8px 0; }
.check-box { width: 22px; height: 22px; border-radius: 6px; border-width: 2px; border-color: rgb(107, 108, 109); margin-right: 10px; flex-shrink: 0; align-items: center; justify-content: center; }
.check-on { background-color: rgb(45, 140, 60); border-color: rgb(45, 140, 60); }
.check-text { font-size: 13px; white-space: normal; flex-shrink: 1; color: rgb(220, 222, 224); }
.wrap { white-space: normal; }
.stat-tiles { flex-direction: row; margin-top: 12px; }
.stat-tile { flex-grow: 1; flex-basis: 0; align-items: center; padding: 12px 6px; margin: 0 4px; }
.stat-value { font-size: 20px; color: rgb(255, 255, 255); }
.stat-label { font-size: 10px; color: rgb(140, 142, 144); letter-spacing: 1px; margin-top: 2px; }
.dash-card { flex-direction: row; align-items: center; margin-bottom: 10px; }
.dots { flex-direction: row; margin-top: 6px; }
.dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 5px; background-color: rgb(44, 46, 48); }
.dot-on { background-color: rgb(122, 212, 70); }
.timeline-row { flex-direction: row; align-items: flex-start; padding: 6px 0; }
.thumb { width: 80px; height: 56px; border-radius: 8px; background-color: rgb(24, 26, 28); margin-right: 12px; flex-shrink: 0; }
.thumb-big { width: 100%; height: 200px; border-radius: 12px; background-color: rgb(14, 16, 18); align-items: center; justify-content: center; }
.dashed { border-width: 2px; border-color: rgb(38, 40, 42); border-radius: 14px; height: 170px; align-items: center; justify-content: center; }
.ring { width: 54px; height: 54px; border-radius: 27px; border-width: 3px; border-color: rgb(45, 140, 60); align-items: center; justify-content: center; }

/* Tracks: broadcast golf graphics over the 3D hole */
.tracks-root { flex-grow: 1; background-color: rgb(156, 194, 222); overflow: hidden; }
.tracks-top { position: absolute; left: 10px; right: 10px; top: 10px; flex-direction: row; align-items: flex-start; }
.tracks-back { width: 40px; height: 40px; border-radius: 20px; background-color: rgba(8, 10, 12, 0.72); color: rgb(255, 255, 255); font-size: 26px; -unity-text-align: middle-center; margin-right: 8px; }
.tracks-holecard { flex-direction: row; border-radius: 10px; overflow: hidden; background-color: rgba(8, 10, 12, 0.82); }
.tracks-numbox { width: 46px; background-color: rgb(45, 140, 60); align-items: center; justify-content: center; }
.tracks-num { font-size: 26px; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.tracks-metabox { padding: 6px 12px 6px 10px; max-width: 200px; }
.tracks-name { font-size: 14px; color: rgb(255, 255, 255); white-space: normal; }
.tracks-meta { font-size: 11px; color: rgb(190, 200, 196); margin-top: 1px; }
.tracks-scorebox { border-radius: 10px; background-color: rgba(8, 10, 12, 0.82); padding: 6px 12px; align-items: center; min-width: 64px; }
.tracks-k { font-size: 9px; letter-spacing: 1.2px; color: rgb(122, 212, 70); }
.tracks-topar { font-size: 26px; color: rgb(255, 255, 255); }
.tracks-card { position: absolute; left: 10px; top: 96px; flex-direction: row; border-radius: 8px; overflow: hidden; background-color: rgba(8, 10, 12, 0.72); }
.tracks-cell { width: 28px; align-items: center; padding: 3px 0 4px 0; }
.tracks-cell-now { background-color: rgba(45, 140, 60, 0.85); }
.tracks-cell-n { font-size: 9px; color: rgb(170, 180, 176); }
.tracks-cell-s { font-size: 13px; color: rgb(255, 255, 255); min-height: 16px; -unity-text-align: middle-center; }
.tracks-under { color: rgb(255, 120, 110); }
.tracks-over { color: rgb(120, 180, 255); }
.tracks-cams { position: absolute; right: 10px; top: 96px; }
.tracks-cam { border-radius: 8px; background-color: rgba(8, 10, 12, 0.66); padding: 6px 10px; margin-bottom: 6px; align-items: center; }
.tracks-cam-on { background-color: rgba(45, 140, 60, 0.92); }
.tracks-cam-t { font-size: 11px; color: rgb(255, 255, 255); }
.tracks-bottom { position: absolute; left: 10px; right: 10px; bottom: 10px; }
.tracks-lower { align-items: flex-start; margin-bottom: 8px; }
.tracks-simrow { flex-direction: row; justify-content: flex-end; }
.tracks-change { font-size: 11px; color: rgb(122, 212, 70); margin-top: 6px; }
.tracks-cap-t { font-size: 18px; color: rgb(255, 255, 255); background-color: rgb(45, 140, 60); padding: 4px 12px; border-radius: 6px 6px 0 0; }
.tracks-cap-s { font-size: 13px; color: rgb(230, 236, 232); background-color: rgba(8, 10, 12, 0.85); padding: 6px 12px; border-radius: 0 6px 6px 6px; white-space: normal; max-width: 420px; }
.tracks-shotbar { flex-direction: row; align-items: stretch; }
.tracks-club { width: 132px; border-radius: 12px; background-color: rgba(8, 10, 12, 0.86); padding: 10px 12px; margin-right: 8px; }
.tracks-club-v { font-size: 18px; color: rgb(255, 255, 255); margin-top: 2px; white-space: normal; }
.tracks-club-s { font-size: 11px; color: rgb(190, 200, 196); white-space: normal; }
.tracks-matcard { border-radius: 12px; background-color: rgba(8, 10, 12, 0.86); padding: 10px 12px; }
.tracks-mat { flex-direction: row; margin: 6px 0 6px 0; }
.tracks-tick { flex-grow: 1; height: 8px; border-radius: 4px; margin-right: 3px; background-color: rgb(52, 56, 58); }
.tracks-tick-on { background-color: rgb(122, 212, 70); }
.tracks-words { font-size: 13px; color: rgb(255, 255, 255); white-space: normal; }
.tracks-sim { min-height: 36px; padding: 0 14px; margin-bottom: 8px; }

/* Rule games (RuleGames.cs) */
.rule-how { align-items: flex-start; margin-bottom: 8px; }
.rule-dot { width: 6px; height: 6px; border-radius: 3px; background-color: rgb(122, 212, 70); margin: 7px 10px 0 0; }
.rule-callcard { align-items: center; padding-top: 14px; padding-bottom: 14px; }
.rule-call { font-size: 30px; -unity-font-style: bold-and-italic; -unity-text-align: middle-center; white-space: normal; }
.rule-pips { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.rule-pip { min-width: 30px; height: 30px; border-radius: 8px; background-color: rgb(38, 41, 44); color: rgb(132, 133, 134); font-size: 13px; -unity-text-align: middle-center; margin: 0 6px 6px 0; padding: 0 6px; }
.rule-pip-on { background-color: rgb(45, 140, 60); color: rgb(255, 255, 255); }
.rule-swatch { width: 10px; height: 10px; border-radius: 5px; margin-right: 10px; }
.rule-now { background-color: rgba(255, 255, 255, 0.05); border-radius: 8px; }
.rule-big { font-size: 40px; -unity-font-style: bold-and-italic; -unity-text-align: middle-center; margin-top: 6px; }
.rule-pip-now { border-width: 2px; border-color: rgb(122, 212, 70); }
.rule-pip-miss { background-color: rgb(58, 28, 28); color: rgb(255, 120, 110); }
.rule-pip-label { background-color: rgba(0, 0, 0, 0); color: rgb(170, 180, 176); min-width: 20px; }
.rule-cups { align-items: center; margin-top: 8px; }
.rule-cuprow { flex-direction: row; justify-content: center; }
.rule-cup { width: 46px; height: 46px; border-radius: 23px; background-color: rgb(196, 40, 48); border-width: 3px; border-color: rgb(240, 240, 240); margin: 3px; align-items: center; justify-content: center; }
.rule-cup-now { border-color: rgb(122, 212, 70); }
.rule-cup-sunk { background-color: rgb(38, 41, 44); border-color: rgb(52, 56, 58); }
.rule-cup-t { color: rgb(255, 255, 255); font-size: 13px; }

/* Game cards (GameCards.cs): the arcade's look */
.gcard { width: 170px; height: 112px; margin-left: 10px; border-radius: 14px; overflow: hidden; -unity-background-scale-mode: scale-and-crop; background-color: rgb(24, 26, 28); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); justify-content: space-between; }
.gcard-big { width: auto; height: 158px; margin: 0 0 12px 0; border-radius: 16px; }
.gcard-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.gcard-top { flex-direction: row; justify-content: flex-end; flex-wrap: wrap; padding: 8px 8px 0 8px; }
.gcard-chip { font-size: 10px; color: rgb(255, 255, 255); background-color: rgba(8, 10, 12, 0.62); border-radius: 7px; padding: 3px 7px; margin-left: 4px; margin-bottom: 4px; }
.gcard-bottom { padding: 0 12px 10px 12px; }
.gcard-name { font-size: 14px; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); white-space: normal; }
.gcard-name-big { font-size: 22px; letter-spacing: 0.5px; }
.gcard-line { font-size: 11px; color: rgb(200, 206, 204); margin-top: 1px; }
.gcard-first { margin-left: 16px; }
.picker-row { align-items: center; }
.picker-row .field { margin: 0; }
.picker-add { margin-left: 8px; border-width: 2px; border-color: rgb(45, 140, 60); border-radius: 22px; padding: 1px; }
.picker-remove { width: 34px; height: 34px; border-radius: 10px; background-color: rgb(255, 82, 82); align-items: center; justify-content: center; margin-left: 8px; }
.picker-remove-t { color: rgb(255, 255, 255); font-size: 18px; }
.gcard-list { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.gcard-list > .muted, .gcard-list > .sub { width: 100%; }
.mode-scroll { margin: 0 0 6px 0; }
.mode-row { flex-direction: row; padding: 0 16px 6px 16px; }
.mode-box { width: 140px; margin-right: 10px; padding: 12px; }
.mode-line { font-size: 11px; color: rgb(132, 133, 134); white-space: normal; }
.tab-top { justify-content: flex-end; }
.totw { height: auto; min-height: 250px; margin: 0; }
.totw-top { padding: 12px 14px 0 14px; }
.totw-bottom { padding: 60px 14px 12px 14px; }
.totw-btn { margin-top: 10px; padding: 11px; }
.totw-kick { align-self: flex-start; background-color: rgba(8, 10, 12, 0.72); border-radius: 8px; padding: 4px 8px; }
/* ConnectSheet: the Puttr connection card (BleModal.js) */
.connect-card { align-items: center; }
.connect-chip { flex-direction: row; align-items: center; align-self: center; background-color: rgba(45, 140, 60, 0.15); padding: 8px 14px; border-radius: 20px; margin-bottom: 20px; }
.connect-chip-off { background-color: rgba(255, 82, 82, 0.15); }
.connect-chip-text { font-size: 12px; margin-left: 8px; letter-spacing: 0.5px; color: rgba(255, 255, 255, 0.5); }
.connect-ring { width: 80px; height: 80px; border-radius: 40px; background-color: rgba(255, 255, 255, 0.06); align-items: center; justify-content: center; margin-bottom: 16px; align-self: center; }
.connect-on { background-color: rgba(45, 140, 60, 0.12); }
.connect-off { background-color: rgba(255, 82, 82, 0.12); }
.connect-amber { background-color: rgba(255, 179, 0, 0.12); }
.connect-logo { width: 46px; height: 50px; }
.connect-title { font-size: 16px; letter-spacing: 0.5px; -unity-text-align: middle-center; color: rgb(255, 255, 255); }
.connect-sub { font-size: 11px; margin-top: 6px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.4); white-space: normal; }
.connect-retry { flex-direction: row; align-self: center; margin-top: 12px; background-color: rgba(255, 255, 255, 0.06); padding: 8px 16px; border-radius: 20px; border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.connect-warn { background-color: rgba(255, 82, 82, 0.1); border-radius: 14px; border-width: 1px; border-color: rgba(255, 82, 82, 0.2); padding: 16px; margin-top: 20px; width: 100%; }
.connect-step { margin-top: 10px; }
.connect-tester { width: 100%; margin-top: 22px; padding-top: 14px; border-top-width: 1px; border-top-color: rgb(44, 48, 50); }
.connect-done { align-self: stretch; }

/* GameScreen: GameIntro's layout. A column up to 500 wide (setup above the fold), Start pinned under it, and in
   landscape the leaderboard as a panel down the right. */
.game-page { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; overflow: hidden; }
.game-main { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.game-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
.game-scroll .page-viewport { align-items: center; }
.game-column { width: 100%; max-width: 500px; padding: 0 16px; align-self: center; }
.game-head { flex-direction: row; align-items: center; margin-top: 4px; }
.game-title { font-size: 22px; white-space: normal; padding: 0 8px; }
.game-trophy { width: 40px; height: 40px; border-radius: 20px; background-color: rgba(255, 255, 255, 0.08); align-items: center; justify-content: center; }
.game-about { margin-top: 4px; white-space: normal; }
.game-rules { flex-direction: row; align-items: center; align-self: flex-start; margin-top: 10px; padding: 6px 12px; border-radius: 14px; background-color: rgba(255, 255, 255, 0.06); }
.game-rules-t { font-size: 12px; margin-left: 6px; color: rgba(255, 255, 255, 0.7); }
.game-foot { flex-shrink: 0; align-items: center; padding: 10px 16px; background-color: rgb(9, 11, 13); border-top-width: 1px; border-top-color: rgb(38, 40, 42); }
.game-go { margin-top: 0; width: 100%; max-width: 468px; }
.game-side { flex-shrink: 0; max-width: 500px; background-color: rgba(0, 0, 0, 0.4); border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.06); }
.game-board { padding: 16px 14px; }
.game-head > .back { width: auto; padding-right: 4px; }
.game-scroll .page-column { width: 100%; }
/* The game page over its backdrop (the game's set, GameBridge.ShowBackdrop): the set shows round a dark panel. */
.game-see { background-color: rgba(9, 11, 13, 0.25); }
.game-see .game-column { background-color: rgba(9, 11, 13, 0.78); border-radius: 18px; padding: 10px 16px 16px 16px; margin-top: 10px; }
.game-see .game-foot { background-color: rgba(9, 11, 13, 0.85); border-top-color: rgba(255, 255, 255, 0.08); }
.game-see .game-side { background-color: rgba(9, 11, 13, 0.78); }
/* Spinner (PuttrSpinner): centred in its box; the cover sits over a screen that has nothing in it yet. */
.spinner { align-items: center; justify-content: center; padding: 16px; }
.spinner-center { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
.spinner-cover { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }

/* Tracks play HUD: camera pill, entry panel, mat putt card, bottom scorecard */
.tracks-camdock { position: absolute; right: 10px; top: 10px; align-items: flex-end; }
.tracks-campill { flex-direction: row; align-items: center; border-radius: 10px; background-color: rgba(8, 10, 12, 0.82); padding: 5px 8px 5px 12px; min-height: 40px; }
.tracks-campill-text { align-items: flex-start; }
.tracks-chev { width: 18px; height: 18px; margin-left: 6px; }
.tracks-camlist { border-radius: 10px; background-color: rgba(8, 10, 12, 0.9); padding: 4px; min-width: 132px; }
.tracks-camlist-head { flex-direction: row; align-items: center; padding: 4px 4px 4px 8px; }
.tracks-camopt { border-radius: 8px; padding: 8px 10px; margin-top: 2px; }
.tracks-camopt-on { background-color: rgba(45, 140, 60, 0.92); }
.tracks-entry { position: absolute; left: 10px; top: 104px; border-radius: 12px; background-color: rgba(8, 10, 12, 0.82); padding: 6px 8px 8px 8px; align-items: center; }
.tracks-entry-mat { width: 112px; height: 112px; margin-top: 4px; border-radius: 8px; overflow: hidden; background-color: rgba(10, 30, 15, 0.95); border-width: 1px; border-color: rgba(255, 255, 255, 0.12); }
.tracks-entry-view { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tracks-entry-k { position: absolute; left: 0; right: 0; top: 3px; font-size: 8px; letter-spacing: 0.5px; color: rgba(255, 255, 255, 0.55); -unity-text-align: middle-center; }
.tracks-entry-v { position: absolute; left: 0; right: 0; bottom: 3px; font-size: 9px; letter-spacing: 0.6px; color: rgb(122, 212, 70); -unity-text-align: middle-center; }
.tracks-entry-miss { color: rgb(255, 82, 82); }
.tracks-wide .tracks-entry-mat { width: 168px; height: 168px; }
.tracks-wide .tracks-entry-k { font-size: 10px; }
.tracks-wide .tracks-entry-v { font-size: 11px; }
.tracks-puttcard { border-radius: 12px; background-color: rgba(8, 10, 12, 0.86); padding: 10px 12px; justify-content: center; }
.tracks-putt-v { font-size: 20px; color: rgb(255, 255, 255); margin-top: 2px; margin-bottom: 2px; }
.tracks-sc { margin-top: 8px; border-radius: 12px; background-color: rgba(8, 10, 12, 0.86); padding: 6px; }
.tracks-sc-row { flex-direction: row; align-items: stretch; }
.tracks-sc-col { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: center; border-radius: 6px; padding: 2px 0; }
.tracks-sc-lab { flex-grow: 0; flex-basis: auto; width: 40px; align-items: flex-start; padding-left: 4px; }
.tracks-sc-lab > .tracks-sc-n, .tracks-sc-lab > .tracks-sc-p, .tracks-sc-lab > .tracks-sc-s { font-size: 8px; letter-spacing: 0.6px; color: rgba(255, 255, 255, 0.5); -unity-text-align: middle-left; }
.tracks-sc-now { background-color: rgba(45, 140, 60, 0.85); }
.tracks-sc-sum { flex-grow: 0; flex-basis: auto; width: 36px; background-color: rgba(255, 255, 255, 0.07); margin-left: 3px; }
.tracks-sc-n { font-size: 10px; color: rgb(170, 180, 176); height: 16px; -unity-text-align: middle-center; }
.tracks-sc-p { font-size: 10px; color: rgb(190, 200, 196); height: 16px; -unity-text-align: middle-center; }
.tracks-sc-s { font-size: 13px; color: rgb(255, 255, 255); height: 18px; -unity-text-align: middle-center; }
.tracks-sc-parbox { width: 54px; margin-left: 4px; border-radius: 8px; background-color: rgba(45, 140, 60, 0.3); align-items: center; justify-content: center; }
.tracks-sc-topar { font-size: 22px; color: rgb(255, 255, 255); }
.tracks-wide .tracks-sc-n { font-size: 11px; }
.tracks-wide .tracks-sc-s { font-size: 15px; height: 20px; }
.tracks-wide .tracks-bottom { left: 16px; right: 16px; bottom: 14px; }
.tracks-wide .tracks-shotbar { align-self: flex-start; width: 560px; }
.tracks-sc-s.tracks-under, .tracks-sc-topar.tracks-under { color: rgb(255, 120, 110); }
.tracks-sc-s.tracks-over { color: rgb(120, 180, 255); }
/* PlayerPicker: Add player, who goes first, Puttr as a Player. */
.picker-first { padding: 6px 10px; border-radius: 12px; background-color: rgba(255, 255, 255, 0.06); margin-left: 8px; }
.picker-first-on { background-color: rgb(45, 140, 60); }
.picker-first-t { font-size: 11px; color: rgb(255, 255, 255); }
.picker-puttr { background-color: rgb(16, 34, 20); }
.picker-add-btn { margin-top: 8px; }

/* Putter brand marks on the league and tournament leaderboards (PutterBrands.cs), and the putter
   sheet a tap on one opens. Colours are puttr-app's PutterDetailModal rgba values over #0a0a0a. */
.brand-badge { justify-content: center; align-items: center; flex-shrink: 0; opacity: 0.9; }
.brand-ring { align-items: center; justify-content: center; border-color: rgb(255, 255, 255); }
.brand-letter { color: rgb(255, 255, 255); -unity-text-align: middle-center; padding: 0; margin: 0; }
.brand-hit { margin-left: 8px; margin-right: 2px; padding: 6px; flex-shrink: 0; justify-content: center; }
.putter-sheet-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6); justify-content: flex-end; align-items: center; color: rgb(255, 255, 255); font-size: 14px; }
.putter-sheet { width: 100%; max-width: 480px; background-color: rgb(10, 10, 10); border-top-left-radius: 24px; border-top-right-radius: 24px; border-top-width: 1px; border-left-width: 1px; border-right-width: 1px; border-color: rgb(30, 30, 30); padding-top: 12px; padding-left: 20px; padding-right: 20px; transition-property: translate; transition-duration: 0.25s; transition-timing-function: ease-out-cubic; }
.putter-sheet-grab-row { align-items: center; margin-bottom: 8px; }
.putter-sheet-grab { width: 42px; height: 4px; border-radius: 2px; background-color: rgb(49, 49, 49); }
.putter-sheet-head { flex-direction: row; align-items: center; margin-bottom: 18px; }
.putter-sheet-head .avatar { width: 40px; height: 40px; border-radius: 20px; margin-right: 12px; }
.putter-sheet-who { overflow: hidden; }
.putter-sheet-kick { font-size: 10px; letter-spacing: 1px; color: rgb(108, 108, 108); }
.putter-sheet-name { font-size: 15px; color: rgb(255, 255, 255); }
.putter-sheet-town { font-size: 11px; color: rgb(120, 120, 120); margin-top: 1px; }
.putter-sheet-close { width: 32px; height: 32px; border-radius: 16px; align-items: center; justify-content: center; background-color: rgb(25, 25, 25); margin-left: 8px; }
.putter-sheet-card { flex-direction: row; align-items: center; background-color: rgb(20, 20, 20); border-width: 1px; border-color: rgb(30, 30, 30); border-radius: 16px; padding: 16px; }
.putter-sheet-disc { width: 64px; height: 64px; border-radius: 32px; align-items: center; justify-content: center; background-color: rgb(34, 34, 34); margin-right: 16px; flex-shrink: 0; }
.putter-sheet-unknown { font-size: 20px; color: rgb(132, 132, 132); }
.putter-sheet-words { overflow: hidden; }
.putter-sheet-brand { font-size: 17px; color: rgb(255, 255, 255); }
.putter-sheet-model { font-size: 14px; color: rgb(206, 206, 206); margin-top: 2px; }
.putter-sheet-specs { font-size: 11px; color: rgb(120, 120, 120); margin-top: 4px; letter-spacing: 0.5px; white-space: normal; }
.tracks-sc-row > .tracks-sc-lab > .tracks-sc-n, .tracks-sc-row > .tracks-sc-lab > .tracks-sc-p, .tracks-sc-row > .tracks-sc-lab > .tracks-sc-s { font-size: 8px; letter-spacing: 0.6px; color: rgba(255, 255, 255, 0.5); -unity-text-align: middle-left; }
.tracks-wide .tracks-bottom > .tracks-shotbar { width: auto; }
.tracks-wide .tracks-puttcard { min-width: 280px; padding-right: 28px; }
.tracks-wide .tracks-sc { align-self: flex-start; min-width: 640px; }
.tracks-wide .tracks-sc-col { min-width: 44px; }
/* Play tab: the ways to play as top tabs, white titles (a sports game's mode bar). */
.play-page { flex-grow: 1; }
.play-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.play-tabs { padding: 8px 16px 0 16px; border-bottom-width: 1px; border-bottom-color: rgb(32, 34, 36); flex-shrink: 0; }
.play-tab { padding: 12px 4px 10px 4px; margin-right: 22px; border-bottom-width: 3px; border-bottom-color: rgba(0, 0, 0, 0); }
.play-tab-on { border-bottom-color: rgb(255, 255, 255); }
.play-tab-t { font-size: 17px; color: rgba(255, 255, 255, 0.45); letter-spacing: 0.5px; }
.play-tab-on .play-tab-t { color: rgb(255, 255, 255); }
.play-online { padding-top: 12px; }
.play-sensor { flex-direction: row; align-items: center; margin-bottom: 12px; width: 100%; }
.gcard-list { justify-content: flex-start; }
/* Ui.IconButton (.ibtn; .icon-btn is the square icon button above): a clean button with an icon (Chat with your coach, History, New chat). */
.ibtn { flex-direction: row; align-items: center; padding: 9px 14px; border-radius: 12px; background-color: rgb(30, 32, 34); border-width: 1px; border-color: rgb(46, 48, 50); }
.ibtn-primary { background-color: rgb(45, 140, 60); border-color: rgb(45, 140, 60); }
.ibtn-t { font-size: 13px; color: rgb(255, 255, 255); margin-left: 8px; }
/* Challenge cards: icon and title in a row, the title wrapped to two lines inside the card. */
.challenge-head { align-items: center; }
.challenge-title { white-space: normal; flex-shrink: 1; min-width: 0; margin-left: 10px; max-height: 40px; overflow: hidden; -unity-text-overflow-position: end; text-overflow: ellipsis; }
.challenge-head .challenge-title { margin-top: 0; }
/* Tournaments list: rows of fixed 220 square posters scrolled sideways (puttr-app TournamentCard). */
.tourn-row { flex-shrink: 0; }
/* League Night in landscape: the Teams and Players boards side by side, half the width each. */
.league-split { flex-direction: row; align-items: flex-start; }
.league-half { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.league-half-l { margin-right: 6px; }
.league-half-r { margin-left: 6px; }
.league-half-title { margin-top: 12px; }
/* Profile header (UserOverview): actions in a row under the name, compact membership and putter rows,
   identity and info side by side on a tablet. */
.profile-head { }
.profile-id { flex-shrink: 1; }
.profile-info { }
.profile-actions { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.profile-action { font-size: 12px; padding: 4px 0; margin: 4px 16px 0 0; -unity-text-align: middle-left; }
.profile-action-green { color: rgb(122, 212, 70); }
.profile-action-blue { color: rgb(86, 135, 255); }
.profile-action-grey { color: rgb(150, 151, 152); }
.profile-mini { flex-direction: row; align-items: center; margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-top-color: rgb(32, 34, 36); }
.profile-mini-icon { width: 30px; height: 30px; border-radius: 9px; align-items: center; justify-content: center; margin-right: 10px; flex-shrink: 0; }
.profile-mini-words { flex-shrink: 1; overflow: hidden; margin-right: 8px; }
.profile-mini-title { font-size: 14px; color: rgb(255, 255, 255); margin: 0; padding: 0; }
.profile-mini-detail { font-size: 12px; color: rgb(132, 133, 134); margin: 2px 0 0 0; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-join { margin: 0; flex-shrink: 0; }
.profile-info > .profile-counts { margin-top: 10px; padding-top: 10px; }
.wide .profile-head { flex-direction: row; align-items: flex-start; }
.wide .profile-id { width: 50%; padding-right: 20px; }
.wide .profile-info { width: 50%; padding-left: 20px; border-left-width: 1px; border-left-color: rgb(32, 34, 36); }
.wide .profile-info > .profile-mini-first { margin-top: 0; padding-top: 0; border-top-width: 0; }
.profile-all { }
.profile-all-second { margin-top: 14px; }
.wide .profile-all { flex-direction: row; }
.wide .profile-all-pair { flex-grow: 1; flex-basis: 0; }
.wide .profile-all-second { margin-top: 0; }
/* Make % by break (Breaks.js): fixed 76px rings that cannot be squeezed, spread evenly. */
.profile-breaks { flex-direction: row; justify-content: space-around; align-items: flex-start; padding-top: 6px; padding-bottom: 2px; }
.profile-break { align-items: center; flex-grow: 1; flex-basis: 0; }
.profile-ring { width: 76px; height: 76px; min-width: 76px; min-height: 76px; flex-shrink: 0; align-items: center; justify-content: center; margin-bottom: 8px; }
.profile-break-name { font-size: 12px; color: rgb(132, 133, 134); -unity-text-align: middle-center; white-space: nowrap; }
.tourn-title-row { align-items: flex-start; }
.tourn-title { white-space: normal; flex-shrink: 1; min-width: 0; margin-right: 8px; }

/* Chats as texting (Chat.cs ChatThread) */
.chat-thread { flex-grow: 1; flex-shrink: 1; }
.chat-thread > .chat-scroll { flex-grow: 1; flex-shrink: 1; }
.chat-list { padding-bottom: 12px; }
.chat-loading { align-items: center; padding: 30px 0; }
.chat-stamp { font-size: 11px; color: rgb(132, 133, 134); -unity-text-align: middle-center; margin: 16px 0 4px 0; }
.chat-line { flex-direction: row; align-items: flex-end; padding: 0 12px; margin-top: 8px; }
.chat-line-cont { margin-top: 2px; }
.chat-line-mine { justify-content: flex-end; }
.chat-line > .chat-face { width: 28px; height: 28px; min-width: 28px; border-radius: 14px; margin-right: 8px; margin-bottom: 1px; flex-shrink: 0; }
.chat-face .avatar-letter { font-size: 13px; }
.chat-bubble-theirs { max-width: 78%; flex-shrink: 1; padding: 9px 13px; border-radius: 18px; border-bottom-left-radius: 6px; background-color: rgb(38, 40, 43); }
.chat-bubble-mine { max-width: 78%; flex-shrink: 1; padding: 9px 13px; border-radius: 18px; border-bottom-right-radius: 6px; background-color: rgb(45, 140, 60); }
.chat-line-cont > .chat-bubble-theirs { border-top-left-radius: 6px; }
.chat-line-cont > .chat-bubble-mine { border-top-right-radius: 6px; }
.chat-words { font-size: 15px; color: rgb(255, 255, 255); white-space: normal; margin: 0; padding: 0; }
.chat-status { font-size: 11px; color: rgb(132, 133, 134); -unity-text-align: middle-right; margin: 3px 14px 0 0; display: none; }
.chat-status-failed { color: rgb(235, 87, 87); }
.chat-row-failed > .chat-bubble-mine { opacity: 0.5; }
.chat-typing-bubble { flex-direction: row; align-items: center; padding: 14px 14px; }
.chat-dot { width: 7px; height: 7px; border-radius: 4px; background-color: rgb(175, 177, 179); margin: 0 2px; opacity: 0.35; }
.chat-bar { flex-direction: row; align-items: flex-end; padding: 8px 10px 8px 12px; background-color: rgb(9, 11, 13); border-top-width: 1px; border-top-color: rgb(32, 34, 36); flex-shrink: 0; }
.chat-pill-input { flex-grow: 1; flex-shrink: 1; min-height: 40px; border-radius: 20px; border-width: 1.5px; border-color: rgb(52, 54, 57); background-color: rgb(24, 26, 28); margin-right: 8px; justify-content: center; }
.chat-pill-input.chat-focus { border-color: rgb(122, 212, 70); background-color: rgb(19, 27, 19); }
.chat-field { margin: 0; flex-grow: 1; --unity-cursor-color: rgb(122, 212, 70); }
.chat-field .unity-base-text-field__input { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 9px 14px; margin: 0; color: rgb(255, 255, 255); font-size: 15px; min-height: 37px; max-height: 120px; }
.chat-field .unity-text-element { white-space: normal; }
.chat-field .unity-base-text-field__input--placeholder { color: rgb(120, 122, 124); }
.chat-send-btn { width: 40px; height: 40px; border-radius: 20px; background-color: rgb(45, 140, 60); align-items: center; justify-content: center; flex-shrink: 0; }
.chat-send-btn:active { background-color: rgb(36, 112, 48); }
.chat-send-btn.chat-send-off { background-color: rgb(44, 46, 49); opacity: 0.55; }
.chat-keyboard-room { flex-shrink: 0; height: 0; background-color: rgb(9, 11, 13); }
/* Tracks course cards: the whole course from overhead (TracksArt), 2:1, the hole numbers laid over it. */
.tracks-ccard { padding: 0; overflow: hidden; }
.tracks-ccard-body { padding: 12px 14px 14px 14px; }
.tracks-art { height: 180px; background-color: rgb(20, 30, 18); overflow: hidden; }
.tracks-art-pic { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; transition-property: opacity; transition-duration: 0.45s; }
.tracks-art-pic.tracks-art-on { opacity: 1; }
.tracks-art-top { position: absolute; left: 10px; right: 10px; top: 8px; flex-direction: row; align-items: center; }
.tracks-art-top > .chip { margin-top: 0; margin-right: 0; }
.tracks-art-chip { font-size: 10px; letter-spacing: 1px; color: rgb(122, 212, 70); background-color: rgba(8, 10, 12, 0.8); border-radius: 7px; padding: 4px 8px; }
.tracks-artnum { position: absolute; width: 17px; height: 17px; margin-left: -8px; margin-top: -8px; border-radius: 9px; background-color: rgba(8, 10, 12, 0.85); border-width: 1px; border-color: rgba(255, 255, 255, 0.6); color: rgb(255, 255, 255); font-size: 8px; padding: 0; -unity-text-align: middle-center; }
/* Tracks setup over the blimp: the course flown high and slow behind a dark glass panel. */
.tracks-setup { flex-grow: 1; background-color: rgb(9, 11, 13); overflow: hidden; }
.tracks-fly-still { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0.5; }
.tracks-fly { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; transition-property: opacity; transition-duration: 1.2s; }
.tracks-fly.tracks-fly-on { opacity: 1; }
.tracks-fly-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(9, 11, 13, 0.3); }
.tracks-setup-page { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tracks-fly-top { position: absolute; left: 0; right: 0; top: 0; height: 150px; }
.tracks-panel { width: 100%; max-width: 560px; align-self: center; margin-top: 12px; padding: 14px 16px 16px 16px; border-radius: 18px; background-color: rgba(9, 11, 13, 0.8); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.tracks-how { border-radius: 14px; padding: 14px; background-color: rgba(30, 33, 35, 0.85); }
.tracks-setup-page .btn { max-width: 560px; align-self: center; width: 100%; }
/* Poster captions stay readable over light artwork: a near-solid band, the dates and Players brighter. */
.poster-panel { background-color: rgba(10, 12, 14, 0.97); }
.poster-line .muted { color: rgb(170, 172, 174); }
/* Challenge titles wrap in full beside the icon (no ellipsis). */
.challenge-head .challenge-title { max-height: none; overflow: visible; text-overflow: clip; }
/* Tracks naming: "Inspired by" in light text before the course name; a pin before the place. */
.tracks-inspired { font-size: 11px; color: rgba(255, 255, 255, 0.5); letter-spacing: 0.5px; margin-bottom: 1px; }
.tracks-where { align-items: center; margin-top: 2px; }
.tracks-where > Label { margin-left: 4px; }
/* Tournament page hero (TournamentView): phone = square art with title on a scrim; wide = art boxed at 240 beside the info. */
.tourn-hero { overflow: hidden; }
.tourn-hero-narrow { padding: 0; }
.tourn-hero-wide { flex-direction: row; align-items: stretch; }
.tourn-art { flex-shrink: 0; flex-grow: 0; border-radius: 12px; overflow: hidden; background-color: rgba(45, 140, 60, 0.1); -unity-background-scale-mode: scale-and-crop; justify-content: flex-end; }
.tourn-hero-narrow .tourn-art { border-radius: 0; align-self: center; }
.tourn-art-icon { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.tourn-scrim { padding: 16px; background-color: rgba(0, 0, 0, 0.72); }
.tourn-status { position: absolute; top: 12px; right: 12px; margin: 0; font-size: 10px; letter-spacing: 0.5px; padding: 4px 10px; border-radius: 10px; }
.tourn-hero-wide .tourn-status { position: relative; top: 0; right: 0; align-self: flex-start; }
.tourn-col { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 16px; }
.tourn-hero-title { font-size: 22px; white-space: normal; margin-top: 8px; }
.tourn-hero-narrow .tourn-hero-title { margin-top: 0; }
.tourn-hero-wide .tourn-hero-title { font-size: 24px; }
.tourn-meta { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.tourn-pill { font-size: 11px; padding: 5px 9px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.9); margin-right: 6px; margin-top: 4px; }
.tourn-hero-narrow .tourn-pill { background-color: rgba(0, 0, 0, 0.45); border-width: 1px; border-color: rgba(255, 255, 255, 0.18); }
.tourn-desc { font-size: 13px; color: rgba(255, 255, 255, 0.55); white-space: normal; margin-top: 10px; }
.tourn-hero-narrow .tourn-desc { margin: 12px 14px 14px 14px; }
.tourn-host { flex-direction: row; align-items: center; }
.tourn-host-flat { margin-top: 12px; }
.tourn-host-pill { position: absolute; top: 12px; left: 12px; max-width: 70%; background-color: rgba(0, 0, 0, 0.55); border-radius: 21px; padding: 5px 13px 5px 5px; }
.tourn-host .avatar { width: 32px; height: 32px; border-radius: 16px; margin-right: 0; }
.tourn-host .avatar-letter { font-size: 13px; }
.tourn-host-words { margin-left: 9px; flex-shrink: 1; min-width: 0; }
.tourn-kick { font-size: 9px; letter-spacing: 1px; color: rgba(255, 255, 255, 0.5); }
.tourn-host-name { font-size: 13px; overflow: hidden; text-overflow: ellipsis; }
.tourn-prize { align-items: center; }
.tourn-prize-words { margin-left: 12px; margin-right: 8px; }
.tourn-prize-text { font-size: 12px; color: rgba(255, 255, 255, 0.45); white-space: normal; }
.tourn-prize-in { margin-top: 12px; padding-top: 12px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.08); }
.tourn-prize-card { margin-top: 12px; }
/* Tournament leaderboard rows (LeaderRow): a tap opens the round scores in place; a played round opens its game. */
.tourn-leader { border-radius: 12px; margin-bottom: 2px; }
.tourn-leader-head { flex-direction: row; align-items: center; padding: 10px 4px; }
.tourn-leader-words { margin-left: 0; margin-right: 10px; min-width: 0; }
.tourn-total { font-size: 15px; background-color: rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 7px 12px; min-width: 52px; -unity-text-align: middle-center; margin-left: 10px; }
.tourn-rounds { flex-direction: row; overflow: hidden; height: 0; opacity: 0; padding: 0 4px; transition-property: height, opacity; transition-duration: 0.22s, 0.22s; transition-timing-function: ease-in-out, ease-in-out; }
.tourn-leader-open .tourn-rounds { height: 62px; opacity: 1; }
.tourn-round { flex-grow: 1; flex-basis: 0; margin: 2px 3px 10px 3px; padding: 8px 0; border-radius: 8px; background-color: rgba(255, 255, 255, 0.04); align-items: center; justify-content: center; }
.tourn-round-played { background-color: rgba(45, 140, 60, 0.15); }
.tourn-round-label { font-size: 10px; color: rgba(255, 255, 255, 0.4); -unity-text-align: middle-center; margin-bottom: 2px; }
.tourn-round-score { font-size: 14px; color: rgba(255, 255, 255, 0.2); -unity-text-align: middle-center; }
.tourn-round-played .tourn-round-score { color: rgb(122, 212, 70); }
/* Game view putt rows: the cup with the entry dot after the number, pace over entry on the right. */
.gv-what { flex-shrink: 1; min-width: 0; }
.gv-hole { width: 34px; height: 34px; flex-shrink: 0; margin: 0 10px 0 0; }
.gv-read { align-items: flex-end; flex-shrink: 0; margin-left: 8px; }
.gv-pace { font-size: 13px; color: rgb(255, 255, 255); }
.gv-entry { font-size: 11px; color: rgb(132, 133, 134); margin-top: 2px; }
