/* Puttr Club: the paywall (ClubScreen) and the plans (ClubPlans), drawn to docs/design-guidelines.md. Solid colours
   only (see the note at the top of App.uss). The screen has one main button, the purchase; every other action is a
   secondary button or a text link. Selectors carry an extra class so they win over App.uss whatever the sheet order. */

.club { padding: 0 16px 32px 16px; }
.club-why { font-size: 13px; color: rgb(196, 201, 205); white-space: normal; margin-top: 8px; -unity-text-align: middle-center; }
.glass.club-card { margin-top: 12px; padding: 16px; }

/* MembershipProducts */
.club-plans { padding: 0; }
.club-loading { align-items: center; justify-content: center; padding: 32px 0; }
.club-plans .club-title { -unity-text-align: middle-center; margin-bottom: 8px; }
.club-sub { font-size: 13px; color: rgb(139, 147, 153); white-space: normal; -unity-text-align: middle-center; }
.club-lead { color: rgb(139, 147, 153); margin-bottom: 24px; }
.club-note { font-size: 13px; color: rgb(139, 147, 153); white-space: normal; -unity-text-align: middle-center; margin-top: 12px; }
/* A plan: a flat card with a line border. The picked one has a bright green border and nothing else. */
.club-plan { flex-direction: row; align-items: center; min-height: 44px; padding: 16px; border-radius: 4px; border-width: 1px; border-color: rgb(38, 42, 46); background-color: rgb(21, 24, 27); margin-bottom: 12px; }
.club-plan-on { border-color: rgb(122, 212, 70); }
.club-radio { width: 22px; height: 22px; border-radius: 11px; border-width: 2px; border-color: rgb(139, 147, 153); margin-right: 12px; align-items: center; justify-content: center; flex-shrink: 0; }
.club-plan-on .club-radio { border-color: rgb(122, 212, 70); }
.club-radio-dot { width: 12px; height: 12px; border-radius: 6px; background-color: rgb(45, 140, 60); }
.club-plan-words { flex-grow: 1; flex-basis: 0; }
.club-plan-name { flex-direction: row; align-items: center; }
.club-plan-label { font-size: 15px; color: rgb(255, 255, 255); margin-right: 8px; }
/* BEST VALUE: a chip (clear, line border, label text), green for its meaning. */
.club-badge { font-size: 11px; letter-spacing: 1.2px; color: rgb(122, 212, 70); background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 2px 8px; }
.club-plan-sub { font-size: 13px; color: rgb(139, 147, 153); margin-top: 4px; }
.club-plans .club-plan-price { color: rgb(255, 255, 255); margin-left: 8px; flex-shrink: 0; }
/* The purchase: the screen's one main button (Ui.Button draws it; this only places it). */
.btn.slant.club-buy { margin-top: 4px; }
.club-buy:disabled { opacity: 0.45; }

/* Rows: Junior, help. The icon sits plain, with no tile behind it. */
.club-row { flex-direction: row; align-items: center; }
.club-tile { width: 24px; height: 44px; border-radius: 4px; background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center; flex-shrink: 0; }
.club-tile-sm { width: 24px; height: 24px; }
.club-tile-grey { background-color: rgba(0, 0, 0, 0); }
.club-row-words { flex-grow: 1; flex-basis: 0; margin-left: 12px; }
.club-row-title { font-size: 15px; color: rgb(255, 255, 255); }
.club-row-sub { font-size: 13px; color: rgb(139, 147, 153); white-space: normal; }
/* Apply, Chat, Activate: secondary buttons (the slanted shape in surface-2). */
.btn.slant.club-small { --fill: rgb(34, 38, 42); min-height: 44px; margin-top: 0; margin-left: 8px; padding-left: 16px; padding-right: 16px; flex-shrink: 0; }
.btn.slant.club-small:hover { --fill: rgb(48, 53, 58); }
.btn.slant.club-small:active { --fill: rgb(21, 24, 27); }
.btn.club-small .btn-text { font-size: 13px; }

/* Website order, Restore */
.club-center { align-items: center; }
.club-center-text { font-size: 13px; color: rgb(139, 147, 153); -unity-text-align: middle-center; margin-bottom: 12px; }
.club-order-row { flex-direction: row; align-items: center; justify-content: center; }
.club-order { width: 96px; margin: 0; }
.club-order .unity-base-text-field__input { background-color: rgb(34, 38, 42); border-width: 1px; border-color: rgb(38, 42, 46); border-radius: 4px; padding: 8px 12px; min-height: 44px; color: rgb(255, 255, 255); font-size: 15px; -unity-text-align: middle-center; }
.club-order:focus .unity-base-text-field__input { border-color: rgb(122, 212, 70); }
.club-order-bad .unity-base-text-field__input { border-color: rgb(255, 82, 82); }
.club-order .unity-base-text-field__input--placeholder { color: rgb(139, 147, 153); }
/* Restore Purchase: a text link (no fill), still 44 tall to tap. */
.btn.slant.club-outline, .btn.slant.club-outline:hover, .btn.slant.club-outline:active { --fill: rgba(0, 0, 0, 0); min-height: 44px; margin-top: 0; padding-left: 16px; padding-right: 16px; }
.btn.club-outline .btn-text { font-size: 13px; letter-spacing: 0; color: rgb(139, 147, 153); -unity-font-style: normal; }
.btn.club-outline:active .btn-text { color: rgb(255, 255, 255); }

/* What Club gives, trial terms, links */
.club-list-title { font-size: 15px; color: rgb(255, 255, 255); }
.club-feature { flex-direction: row; align-items: center; margin-top: 16px; }
.club-feature-title { font-size: 15px; color: rgb(255, 255, 255); }
.club-terms-title { font-size: 13px; color: rgb(139, 147, 153); margin-bottom: 8px; }
.club-terms { font-size: 11px; color: rgb(139, 147, 153); white-space: normal; }
.club-links { flex-direction: row; justify-content: center; margin-top: 16px; }
.club-link { font-size: 13px; color: rgb(139, 147, 153); margin: 0 12px; padding: 12px 0; }
