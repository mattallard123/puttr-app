/* Live setup (Live.cs LiveSetupScreen): a compact opponent row; the chosen avatar sits in a 1 px bright green square. */
.live-friend { width: 76px; align-items: center; margin-right: 4px; }
.live-ring { width: 60px; height: 60px; border-radius: 4px; border-width: 1px; border-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center; }
.live-ring-on { border-color: rgb(122, 212, 70); }
.live-ring > .avatar { width: 50px; height: 50px; border-radius: 4px; margin: 0; }
.live-friend-name { font-size: 11px; color: rgb(196, 201, 205); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 76px; -unity-text-align: middle-center; }
/* The chosen option gets the green edge App.uss gives it a colour for, so a tap reads at a glance. */
.choice-on { border-width: 1px; }
/* The final screen of a live game (Live.cs LiveResult.View). Solid colours only: the project is linear.
   The sudden-death note and marker are plain labels; the putts are rows of one bordered block with dividers. */
.live-final-note { align-self: center; margin-top: 12px; font-size: 11px; letter-spacing: 1.5px; color: rgb(139, 147, 153); white-space: normal; -unity-text-align: middle-center; }
.live-table { margin-top: 12px; border-radius: 4px; overflow: hidden; background-color: rgb(21, 24, 27); border-width: 1px; border-color: rgb(38, 42, 46); }
.live-row { flex-direction: row; align-items: center; padding-top: 12px; padding-bottom: 12px; border-top-width: 1px; border-top-color: rgb(38, 42, 46); }
.live-row-first { border-top-width: 0; }
.live-mark { width: 60px; align-items: center; justify-content: center; flex-shrink: 0; }
.live-putt { flex-grow: 1; flex-basis: 0; align-items: center; }
.live-extra { font-size: 11px; letter-spacing: 1.5px; color: rgb(139, 147, 153); -unity-text-align: middle-center; }
